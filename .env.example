# DeepSeek quickstart. See README.md for OpenAI, Anthropic, and OpenRouter.
SNIFF_API_KEY=your-deepseek-key
SNIFF_ENDPOINT=https://api.deepseek.com
SNIFF_MODEL=deepseek-v4-flash

# Optional estimated rates in USD per million tokens.
SNIFF_INPUT_COST_PER_MILLION=0.14
SNIFF_CACHED_INPUT_COST_PER_MILLION=0.0028
SNIFF_OUTPUT_COST_PER_MILLION=0.28

# Ask before a real scan when the conservative upper estimate reaches this.
SNIFF_CONFIRM_COST_USD=1.00
