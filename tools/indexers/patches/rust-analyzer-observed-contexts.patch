+#[test]
+fn default_mode_keeps_no_source_snapshots() {
+    let mut vfs = Vfs::default();
+    assert!(vfs.set_file_contents(path(), Some(b"ordinary".to_vec())));
+    let (id, _) = vfs.file_id(&path()).unwrap();
+    assert!(vfs.source_snapshot(id).is_none());
+    assert!(!vfs.set_file_contents(path(), Some(b"ordinary".to_vec())));
+    vfs.take_changes();
+    assert!(vfs.source_snapshot(id).is_none());
+}
