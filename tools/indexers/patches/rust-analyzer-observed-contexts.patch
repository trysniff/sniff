index 0000000..a7bc8cf
--- /dev/null
+++ b/crates/rust-analyzer/src/cli/sniff_project_model.rs
@@ -0,0 +1,891 @@
+//! Observed rust-analyzer contexts. This export does not claim an exhaustive Cargo world domain.
+
+use anyhow::{Context, Result, ensure};
+use cfg::{CfgAtom, CfgOptions};
+use hir::{AnyDiagnostic, Crate};
+use ide::RootDatabase;
+use load_cargo::{LoadCargoConfig, load_workspace_with_source_snapshots};
+use proc_macro_api::ProcMacroClient;
+use project_model::{CargoConfig, ProjectManifest, ProjectWorkspace, ProjectWorkspaceKind};
+use serde_derive::Serialize;
+use std::{
+    collections::{BTreeMap, BTreeSet},
+    io::Write,
+    path::{Path, PathBuf},
+};
+use vfs::{AbsPathBuf, Vfs};
+
+#[derive(Debug, Clone, PartialEq, Eq, PartialOrd, Ord, Serialize)]
+#[serde(tag = "kind", rename_all = "snake_case")]
+enum CfgFact {
+    Flag { name: String },
+    KeyValue { key: String, value: String },
+}
+
+fn cfg_facts(options: &CfgOptions) -> Vec<CfgFact> {
+    let mut facts = options
+        .into_iter()
+        .map(|atom| match atom {
+            CfgAtom::Flag(name) => CfgFact::Flag { name: name.to_string() },
+            CfgAtom::KeyValue { key, value } => {
+                CfgFact::KeyValue { key: key.to_string(), value: value.to_string() }
+            }
+        })
+        .collect::<Vec<_>>();
+    facts.sort();
+    facts
+}
+
+#[derive(Debug, Clone, PartialEq, Eq, PartialOrd, Ord, Serialize)]
+struct CrateIdentity {
+    root: String,
+    name: Option<String>,
+    edition: String,
+    analysis_cfg: Vec<CfgFact>,
+    environment: BTreeMap<String, String>,
+}
+
+#[derive(Serialize)]
+struct Dependency {
+    name: String,
+    context: CrateIdentity,
+}
+
+#[derive(Debug, Clone, PartialEq, Eq, PartialOrd, Ord, Serialize)]
+struct InactiveRange {
+    file: String,
+    start_byte: u32,
+    end_byte: u32,
+    analysis_cfg: Vec<CfgFact>,
+}
+
+#[derive(Serialize)]
+struct CrateContext {
+    identity: CrateIdentity,
+    dependencies: Vec<Dependency>,
+    in_repository: bool,
+    repository_diagnostics_queried: bool,
+    block_local_module_file_coverage_complete: bool,
+    module_files: Vec<String>,
+    included_files: Vec<String>,
+    parser_errors: Vec<ParserError>,
+    inactive_ranges: Vec<InactiveRange>,
+    unmapped_module_sources: usize,
+    unmapped_include_parser_errors: usize,
+    include_expansion_errors: usize,
+    unmapped_inactive_ranges: usize,
+    other_diagnostics: usize,
+}
+
+#[derive(Debug, PartialEq, Eq, PartialOrd, Ord, Serialize)]
+struct ParserError {
+    file: String,
+    start_byte: u32,
+    end_byte: u32,
+    message: String,
+}
+
+#[derive(Serialize)]
+struct ScipBinding {
+    byte_length: usize,
+    tenthash_hex: String,
+    sha256_hex: String,
+    cryptographic_seal: bool,
+    occurrence_context_selection: &'static str,
+    document_contexts: Option<Vec<DocumentContext>>,
+    symbol_context_namespaces: Option<Vec<SymbolContextNamespace>>,
+}
+
+#[derive(Serialize)]
+struct SymbolContextNamespace {
+    namespace: String,
+    context: CrateIdentity,
+}
+
+#[derive(Serialize)]
+struct DocumentContext {
+    relative_path: String,
+    context: CrateIdentity,
+}
+
+#[derive(Serialize)]
+struct ObservedModel {
+    schema_version: u32,
+    contract: &'static str,
+    provider_version: String,
+    declared_world_domain_complete: bool,
+    input_closure_proven: bool,
+    scip_binding: Option<ScipBinding>,
+    selected_root_context: Option<CrateIdentity>,
+    source_bindings: Vec<super::sniff_source_binding::SourceBinding>,
+    crates: Vec<CrateContext>,
+}
+
+pub(super) fn load_observed_workspace(
+    root: &AbsPathBuf,
+    cargo: &CargoConfig,
+    load: &LoadCargoConfig,
+    progress: &(dyn Fn(String) + Sync),
+) -> Result<(RootDatabase, Vfs, Option<ProcMacroClient>)> {
+    let manifest = ProjectManifest::discover_single(root)?;
+    ensure!(
+        matches!(manifest, ProjectManifest::CargoToml(_)),
+        "Sniff crate-context export requires a Cargo workspace"
+    );
+    ensure!(!cargo.no_deps, "Sniff crate-context export requires full dependency metadata");
+    let mut cargo = cargo.clone();
+    cargo.strict_discovery = true;
+    let mut workspace = ProjectWorkspace::load(manifest, &cargo, progress)?;
+    match &workspace.kind {
+        ProjectWorkspaceKind::Cargo { error, .. } => ensure!(
+            error.is_none(),
+            "degraded Cargo metadata cannot be exported as observed compiler context: {error:?}"
+        ),
+        _ => anyhow::bail!("Sniff crate-context export requires a Cargo workspace"),
+    }
+    ensure!(
+        workspace.sysroot.metadata_error().is_none(),
+        "degraded sysroot metadata cannot be exported: {:?}",
+        workspace.sysroot.metadata_error()
+    );
+    ensure!(
+        workspace.sysroot.has_full_cargo_metadata(),
+        "sysroot dependency metadata is not compiler-produced Cargo metadata"
+    );
+    ensure!(
+        workspace.sysroot.error().is_none(),
+        "failed sysroot context cannot be exported: {:?}",
+        workspace.sysroot.error()
+    );
+    ensure!(!workspace.sysroot.is_rust_lib_src_empty(), "sysroot source context is unavailable");
+    ensure!(workspace.toolchain.is_some(), "Rust toolchain identity is unavailable");
+    ensure!(
+        workspace.target.is_ok(),
+        "Rust target data layout is unavailable: {:?}",
+        workspace.target
+    );
+    ensure!(!workspace.rustc_cfg.is_empty(), "Rust compiler cfg query is unavailable");
+    ensure!(load.load_out_dirs_from_check, "build-script context must be loaded");
+    let scripts = workspace.run_build_scripts(&cargo, progress)?;
+    ensure!(
+        scripts.error().is_none(),
+        "failed build-script context cannot be exported: {:?}",
+        scripts.error()
+    );
+    workspace.set_build_scripts(scripts);
+    load_workspace_with_source_snapshots(workspace, &cargo.extra_env, load)
+}
+
+fn identity(krate: Crate, db: &RootDatabase, vfs: &Vfs) -> Result<CrateIdentity> {
+    let root = vfs.file_path(krate.root_file(db));
+    let root = root.as_path().context("crate root is not a real file")?.to_string();
+    Ok(CrateIdentity {
+        root,
+        name: krate.display_name(db).map(|name| name.to_string()),
+        edition: krate.edition(db).to_string(),
+        analysis_cfg: cfg_facts(krate.cfg(db)),
+        environment: krate
+            .base()
+            .env(db)
+            .into_iter()
+            .map(|(key, value)| (key.clone(), value.clone()))
+            .collect(),
+    })
+}
+
+fn observed_model(db: &RootDatabase, vfs: &Vfs, root: &AbsPathBuf) -> Result<ObservedModel> {
+    hir::attach_db(db, || observed_model_attached(db, vfs, root))
+}
+
+pub(super) fn context_namespaces(
+    db: &RootDatabase,
+    vfs: &Vfs,
+) -> Result<ide_db::FxHashMap<Crate, String>> {
+    let mut namespaces = ide_db::FxHashMap::default();
+    let mut seen = BTreeSet::new();
+    for krate in Crate::all(db) {
+        let bytes = serde_json::to_vec(&identity(krate, db, vfs)?)?;
+        let digest = super::sniff_source_binding::sha256_hex(&bytes);
+        let name = format!("sniff-context-{digest}");
+        ensure!(seen.insert(name.clone()), "ambiguous compiler-context namespace");
+        namespaces.insert(krate, name);
+    }
+    Ok(namespaces)
+}
+
+fn observed_model_attached(
+    db: &RootDatabase,
+    vfs: &Vfs,
+    root: &AbsPathBuf,
+) -> Result<ObservedModel> {
+    let source_bindings = super::sniff_source_binding::source_bindings(db, vfs)?;
+    let mut crates = Vec::new();
+    let associations = super::sniff_source_context::source_associations(db);
+    for krate in Crate::all(db) {
+        let identity = identity(krate, db, vfs)?;
+        let in_repository =
+            vfs.file_path(krate.root_file(db)).as_path().is_some_and(|path| path.starts_with(root));
+        let mut dependencies = krate
+            .dependencies(db)
+            .into_iter()
+            .map(|dep| {
+                Ok(Dependency {
+                    name: dep.name.display(db, krate.edition(db)).to_string(),
+                    context: self::identity(dep.krate, db, vfs)?,
+                })
+            })
+            .collect::<Result<Vec<_>>>()?;
+        dependencies
+            .sort_by(|left, right| (&left.name, &left.context).cmp(&(&right.name, &right.context)));
+        let mut module_files = BTreeSet::new();
+        let mut included_files = BTreeSet::new();
+        let mut parser_errors = BTreeSet::new();
+        let mut inactive_ranges = BTreeSet::new();
+        let mut unmapped_module_sources = 0;
+        let mut unmapped_include_parser_errors = 0;
+        let mut include_expansion_errors = 0;
+        let mut unmapped_inactive_ranges = 0;
+        let mut other_diagnostics = 0;
+        if in_repository {
+            let sources =
+                associations.crates.get(&krate).context("missing observed crate sources")?;
+            let mut parsed_files = ide_db::FxHashSet::default();
+            let mut observe_file = |file: ide_db::base_db::EditionedFileId| {
+                let path = vfs.file_path(file.file_id(db));
+                let path = path.as_path()?.to_string();
+                if parsed_files.insert(file) {
+                    for error in file.parse_errors(db).into_iter().flatten() {
+                        parser_errors.insert(ParserError {
+                            file: path.clone(),
+                            start_byte: error.range().start().into(),
+                            end_byte: error.range().end().into(),
+                            message: error.to_string(),
+                        });
+                    }
+                }
+                Some(path)
+            };
+            for module in &sources.modules {
+                match module.definition_source_file_id(db).file_id() {
+                    Some(file) => {
+                        if let Some(path) = observe_file(file) {
+                            module_files.insert(path);
+                        } else {
+                            unmapped_module_sources += 1;
+                        }
+                    }
+                    None => unmapped_module_sources += 1,
+                }
+            }
+            for (&file, calls) in &sources.included_files {
+                let path = vfs.file_path(file.file_id(db));
+                let Some(path) = path.as_path() else {
+                    unmapped_module_sources += 1;
+                    continue;
+                };
+                included_files.insert(path.to_string());
+                for &call in calls {
+                    for error in super::sniff_source_context::included_parse_errors(db, file, call)?
+                    {
+                        parser_errors.insert(ParserError {
+                            file: path.to_string(),
+                            start_byte: error.range().start().into(),
+                            end_byte: error.range().end().into(),
+                            message: error.to_string(),
+                        });
+                    }
+                    let expansion = call.parse_macro_expansion(db);
+                    include_expansion_errors += usize::from(expansion.err.is_some());
+                    for error in expansion.value.0.errors() {
+                        let range =
+                            hir_expand::map_node_range_up(db, &expansion.value.1, error.range());
+                        if let Some((range, _)) = range.filter(|(range, _)| range.file_id == file) {
+                            parser_errors.insert(ParserError {
+                                file: path.to_string(),
+                                start_byte: range.range.start().into(),
+                                end_byte: range.range.end().into(),
+                                message: error.to_string(),
+                            });
+                        } else {
+                            unmapped_include_parser_errors += 1;
+                        }
+                    }
+                }
+            }
+            for module in krate.modules(db) {
+                // Module::diagnostics already traverses inline descendants.
+                if module.is_inline(db) {
+                    continue;
+                }
+                let mut diagnostics = Vec::new();
+                module.diagnostics(db, &mut diagnostics, false);
+                for diagnostic in diagnostics {
+                    match diagnostic {
+                        AnyDiagnostic::InactiveCode(code) => {
+                            let Some(file) = code.node.file_id.file_id() else {
+                                // Macro expansion locations are not original-source exclusion proof.
+                                unmapped_inactive_ranges += 1;
+                                continue;
+                            };
+                            let path = vfs.file_path(file.file_id(db));
+                            let Some(path) = path.as_path() else {
+                                unmapped_inactive_ranges += 1;
+                                continue;
+                            };
+                            let range = code.node.value.text_range();
+                            inactive_ranges.insert(InactiveRange {
+                                file: path.to_string(),
+                                start_byte: range.start().into(),
+                                end_byte: range.end().into(),
+                                analysis_cfg: cfg_facts(&code.opts),
+                            });
+                        }
+                        _ => other_diagnostics += 1,
+                    }
+                }
+            }
+        }
+        crates.push(CrateContext {
+            identity,
+            dependencies,
+            in_repository,
+            repository_diagnostics_queried: in_repository,
+            // Observed block maps do not prove exhaustive macro/source coverage.
+            block_local_module_file_coverage_complete: false,
+            module_files: module_files.into_iter().collect(),
+            included_files: included_files.into_iter().collect(),
+            parser_errors: parser_errors.into_iter().collect(),
+            inactive_ranges: inactive_ranges.into_iter().collect(),
+            unmapped_module_sources,
+            unmapped_include_parser_errors,
+            include_expansion_errors,
+            unmapped_inactive_ranges,
+            other_diagnostics,
+        });
+    }
+    ensure!(
+        crates.iter().any(|context| context.in_repository),
+        "no observed repository crate context"
+    );
+    crates.sort_by(|left, right| left.identity.cmp(&right.identity));
+    ensure!(
+        crates.windows(2).all(|pair| pair[0].identity != pair[1].identity),
+        "ambiguous backend crate context identity"
+    );
+    Ok(ObservedModel {
+        schema_version: 3,
+        contract: "sniff-rust-observed-crate-contexts-v3-not-world-admission",
+        provider_version: crate::version::version().to_string(),
+        declared_world_domain_complete: false,
+        input_closure_proven: false,
+        scip_binding: None,
+        selected_root_context: None,
+        source_bindings,
+        crates,
+    })
+}
+
+pub(super) struct ObservedOutputs {
+    scip_path: PathBuf,
+    model_path: PathBuf,
+    selected_context: Option<Crate>,
+}
+
+fn destination(path: &Path) -> Result<PathBuf> {
+    let path = std::path::absolute(path)?;
+    ensure!(
+        path.symlink_metadata().is_err_and(|error| error.kind() == std::io::ErrorKind::NotFound),
+        "observed output destination must not exist: {}",
+        path.display()
+    );
+    let name = path.file_name().context("output destination has no filename")?;
+    let parent = path.parent().context("output destination has no parent")?.canonicalize()?;
+    Ok(parent.join(name))
+}
+
+impl ObservedOutputs {
+    pub(super) fn prepare(scip: &Path, model: &Path) -> Result<Self> {
+        let scip_path = destination(scip)?;
+        let model_path = destination(model)?;
+        let same = if cfg!(windows) {
+            scip_path
+                .as_os_str()
+                .as_encoded_bytes()
+                .eq_ignore_ascii_case(model_path.as_os_str().as_encoded_bytes())
+        } else {
+            scip_path == model_path
+        };
+        ensure!(!same, "SCIP and observed-context outputs must be distinct");
+        Ok(Self { scip_path, model_path, selected_context: None })
+    }
+
+    pub(super) fn bind_context(mut self, context: Option<Crate>) -> Self {
+        self.selected_context = context;
+        self
+    }
+
+    pub(super) fn publish(
+        self,
+        mut index: scip::types::Index,
+        db: &RootDatabase,
+        vfs: &Vfs,
+        root: &AbsPathBuf,
+    ) -> Result<()> {
+        if cfg!(windows) {
+            for document in &mut index.documents {
+                document.relative_path = document.relative_path.replace('\\', "/");
+            }
+        }
+        let mut model = observed_model(db, vfs, root)?;
+        super::sniff_source_binding::validate_document_sources(
+            &index,
+            &model.source_bindings,
+            root,
+        )?;
+        let symbol_context_namespaces = if self.selected_context.is_some() {
+            let mut namespaces = context_namespaces(db, vfs)?
+                .into_iter()
+                .map(|(krate, namespace)| {
+                    Ok(SymbolContextNamespace { namespace, context: identity(krate, db, vfs)? })
+                })
+                .collect::<Result<Vec<_>>>()?;
+            namespaces.sort_by(|left, right| left.namespace.cmp(&right.namespace));
+            Some(namespaces)
+        } else {
+            None
+        };
+        let document_contexts = if let Some(selected) = self.selected_context {
+            ensure!(
+                Crate::all(db).contains(&selected),
+                "selected compiler context was not retained"
+            );
+            model.selected_root_context = Some(identity(selected, db, vfs)?);
+            let mut contexts = Vec::new();
+            let counts = super::sniff_source_context::association_counts(db);
+            for document in &index.documents {
+                let path = vfs::VfsPath::from(root.join(&document.relative_path));
+                let (file, excluded) = vfs
+                    .file_id(&path)
+                    .context("indexed document has no compiler source identity")?;
+                ensure!(
+                    excluded == vfs::FileExcluded::No,
+                    "indexed document is excluded from compiler source"
+                );
+                let owner =
+                    super::sniff_crate_context::document_owner_with_counts(db, file, &counts)?;
+                contexts.push(DocumentContext {
+                    relative_path: document.relative_path.clone(),
+                    context: identity(owner, db, vfs)?,
+                });
+            }
+            contexts.sort_by(|left, right| left.relative_path.cmp(&right.relative_path));
+            ensure!(
+                contexts.windows(2).all(|pair| pair[0].relative_path != pair[1].relative_path),
+                "duplicate context-bound SCIP document"
+            );
+            Some(contexts)
+        } else {
+            None
+        };
+        let scip_bytes = protobuf::Message::write_to_bytes(&index)?;
+        let mut staged_scip = tempfile::NamedTempFile::new_in(self.scip_path.parent().unwrap())?;
+        staged_scip.write_all(&scip_bytes)?;
+        staged_scip.as_file().sync_all()?;
+        model.scip_binding = Some(ScipBinding {
+            byte_length: scip_bytes.len(),
+            tenthash_hex: tenthash::hash(&scip_bytes)
+                .iter()
+                .map(|byte| format!("{byte:02x}"))
+                .collect(),
+            sha256_hex: super::sniff_source_binding::sha256_hex(&scip_bytes),
+            // Byte commitments are not signed provenance or world admission.
+            cryptographic_seal: false,
+            occurrence_context_selection: if self.selected_context.is_some() {
+                "selected-crate-closure-unique-source-associations"
+            } else {
+                "unavailable"
+            },
+            document_contexts,
+            symbol_context_namespaces,
+        });
+        let mut staged_model = tempfile::NamedTempFile::new_in(self.model_path.parent().unwrap())?;
+        staged_model.write_all(&serde_json::to_vec(&model)?)?;
+        staged_model.as_file().sync_all()?;
+        staged_scip.persist_noclobber(&self.scip_path)?;
+        // A failure here leaves only a complete SCIP, never a successful sidecar.
+        staged_model.persist_noclobber(&self.model_path)?;
+        Ok(())
+    }
+}
