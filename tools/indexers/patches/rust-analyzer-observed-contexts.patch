@@ -0,0 +1,221 @@
+//! Compiler-owned source associations, including body/block maps and include expansions.
+
+use hir::{Crate, MacroCallId, Module};
+use hir_def::{
+    AdtId, DefWithBodyId, ExpressionStoreOwnerId, GenericDefId, ModuleDefId,
+    expr_store::ExpressionStore,
+    nameres::{
+        assoc::{ImplItems, TraitItems},
+        crate_def_map,
+    },
+};
+use ide::RootDatabase;
+use ide_db::{
+    FxHashMap, FxHashSet,
+    base_db::{EditionedFileId, SourceDatabase},
+};
+use vfs::FileId;
+
+#[derive(Default)]
+pub(super) struct CrateSources {
+    pub(super) modules: FxHashSet<Module>,
+    pub(super) included_files: FxHashMap<EditionedFileId, FxHashSet<MacroCallId>>,
+}
+
+pub(super) struct SourceAssociations {
+    pub(super) counts: FxHashMap<FileId, usize>,
+    pub(super) crates: FxHashMap<Crate, CrateSources>,
+}
+
+pub(super) fn included_parse_errors(
+    db: &RootDatabase,
+    file: EditionedFileId,
+    call: MacroCallId,
+) -> anyhow::Result<Vec<syntax::SyntaxError>> {
+    use hir_expand::{ExpandTo, MacroCallKind};
+    let MacroCallKind::FnLike { expand_to, .. } = call.loc(db).kind else {
+        anyhow::bail!("included source has no compiler fragment context");
+    };
+    let entry = match expand_to {
+        ExpandTo::Statements => parser::TopEntryPoint::MacroStmts,
+        ExpandTo::Items => parser::TopEntryPoint::MacroItems,
+        ExpandTo::Pattern => parser::TopEntryPoint::Pattern,
+        ExpandTo::Type => parser::TopEntryPoint::Type,
+        ExpandTo::Expr => parser::TopEntryPoint::Expr,
+    };
+    let edition = file.edition(db);
+    let text = db.file_text(file.file_id(db)).text(db);
+    anyhow::ensure!(
+        text.len() <= u32::MAX as usize,
+        "included source exceeds parser range capacity"
+    );
+    let mut lexed = parser::LexedStr::new(edition, text);
+    let prefix = if !lexed.is_empty() && lexed.kind(0) == syntax::SyntaxKind::SHEBANG {
+        lexed.text_range(0).end
+    } else {
+        0
+    };
+    if prefix != 0 {
+        lexed = parser::LexedStr::new(edition, &text[prefix..]);
+    }
+    let output = entry.parse(&lexed.to_input(edition));
+    let mut builder = syntax::SyntaxTreeBuilder::default();
+    let eof = lexed.intersperse_trivia(&output, &mut |step| match step {
+        parser::StrStep::Token { kind, text } => builder.token(kind, text),
+        parser::StrStep::Enter { kind } => builder.start_node(kind),
+        parser::StrStep::Exit => builder.finish_node(),
+        parser::StrStep::Error { msg, pos } => builder.error(msg.to_owned(), (pos as u32).into()),
+    });
+    anyhow::ensure!(eof, "compiler fragment parser did not consume included source");
+    let mut errors = builder
+        .finish()
+        .errors()
+        .into_iter()
+        .map(|error| {
+            let range = error.range();
+            syntax::SyntaxError::new(
+                error.to_string(),
+                range + syntax::TextSize::from(prefix as u32),
+            )
+        })
+        .collect::<Vec<_>>();
+    for (index, message) in lexed.errors() {
+        let range = lexed.text_range(index);
+        errors.push(syntax::SyntaxError::new(
+            message,
+            syntax::TextRange::new(
+                ((range.start + prefix) as u32).into(),
+                ((range.end + prefix) as u32).into(),
+            ),
+        ));
+    }
+    Ok(errors)
+}
+
+fn queue_item(item: ModuleDefId, stores: &mut Vec<ExpressionStoreOwnerId>) {
+    let generic: GenericDefId = match item {
+        ModuleDefId::FunctionId(id) => id.into(),
+        ModuleDefId::StaticId(id) => id.into(),
+        ModuleDefId::ConstId(id) => id.into(),
+        ModuleDefId::AdtId(id) => id.into(),
+        ModuleDefId::TraitId(id) => id.into(),
+        ModuleDefId::TypeAliasId(id) => id.into(),
+        _ => return,
+    };
+    stores.push(generic.into());
+    match item {
+        ModuleDefId::FunctionId(id) => stores.push(DefWithBodyId::from(id).into()),
+        ModuleDefId::StaticId(id) => stores.push(DefWithBodyId::from(id).into()),
+        ModuleDefId::ConstId(id) => stores.push(DefWithBodyId::from(id).into()),
+        ModuleDefId::AdtId(AdtId::StructId(id)) => stores.push(hir_def::VariantId::from(id).into()),
+        ModuleDefId::AdtId(AdtId::UnionId(id)) => stores.push(hir_def::VariantId::from(id).into()),
+        _ => {}
+    }
+}
+
+fn record_include(
+    db: &RootDatabase,
+    call: MacroCallId,
+    includes: &mut FxHashMap<FileId, FxHashSet<MacroCallId>>,
+    crates: &mut FxHashMap<Crate, CrateSources>,
+) {
+    let location = call.loc(db);
+    if let Some(file) = location.include_file_id(db, call) {
+        includes.entry(file.file_id(db)).or_default().insert(call);
+        crates
+            .entry(location.krate.into())
+            .or_default()
+            .included_files
+            .entry(file)
+            .or_default()
+            .insert(call);
+    }
+}
+
+pub(super) fn association_counts(db: &RootDatabase) -> FxHashMap<FileId, usize> {
+    source_associations(db).counts
+}
+
+pub(super) fn source_associations(db: &RootDatabase) -> SourceAssociations {
+    hir::attach_db(db, || {
+        let mut direct = FxHashMap::<_, FxHashSet<_>>::default();
+        let mut includes = FxHashMap::<_, FxHashSet<_>>::default();
+        let mut crates = FxHashMap::<_, CrateSources>::default();
+        let mut maps = Crate::all(db)
+            .into_iter()
+            .map(|krate| crate_def_map(db, krate.base()))
+            .collect::<Vec<_>>();
+        let mut stores = Vec::new();
+        let mut visited_maps = FxHashSet::default();
+        let mut visited_stores = FxHashSet::default();
+        while !maps.is_empty() || !stores.is_empty() {
+            while let Some(map) = maps.pop() {
+                if !visited_maps.insert(map.root) {
+                    continue;
+                }
+                for (module_id, module) in map.modules() {
+                    let observed = Module::from(module_id);
+                    crates.entry(observed.krate(db)).or_default().modules.insert(observed);
+                    if let Some(file) = module.origin.file_id() {
+                        direct.entry(file.file_id(db)).or_default().insert(module_id);
+                    }
+                    for call in module.scope.all_macro_calls() {
+                        record_include(db, call, &mut includes, &mut crates);
+                    }
+                    for id in module.scope.unnamed_consts() {
+                        queue_item(id.into(), &mut stores);
+                    }
+                    for item in module.scope.declarations() {
+                        queue_item(item, &mut stores);
+                        match item {
+                            ModuleDefId::TraitId(id) => {
+                                let items = &TraitItems::query_with_diagnostics(db, id).0;
+                                for (_, item) in &items.items {
+                                    queue_item((*item).into(), &mut stores);
+                                }
+                                for (_, call) in items.macro_calls() {
+                                    record_include(db, call, &mut includes, &mut crates);
+                                }
+                            }
+                            ModuleDefId::AdtId(AdtId::EnumId(id)) => {
+                                for &(variant, _) in id.enum_variants(db).variants.values() {
+                                    stores.push(DefWithBodyId::from(variant).into());
+                                    stores.push(hir_def::VariantId::from(variant).into());
+                                }
+                            }
+                            _ => {}
+                        }
+                    }
+                    for id in module.scope.impls() {
+                        stores.push(id.into());
+                        let items = &ImplItems::of(db, id).0;
+                        for (_, item) in &items.items {
+                            queue_item((*item).into(), &mut stores);
+                        }
+                        for (_, call) in items.macro_calls() {
+                            record_include(db, call, &mut includes, &mut crates);
+                        }
+                    }
+                }
+            }
+            while let Some(owner) = stores.pop() {
+                if !visited_stores.insert(owner) {
+                    continue;
+                }
+                let (store, sources) = ExpressionStore::with_source_map(db, owner);
+                maps.extend(store.blocks(db).map(|(_, map)| map));
+                for (_, call) in sources.macro_calls() {
+                    record_include(db, call, &mut includes, &mut crates);
+                }
+            }
+        }
+        let mut counts = direct
+            .into_iter()
+            .map(|(file, modules)| (file, modules.len()))
+            .collect::<FxHashMap<_, _>>();
+        for (file, calls) in includes {
+            *counts.entry(file).or_default() += calls.len();
+        }
+        SourceAssociations { counts, crates }
+    })
+}
