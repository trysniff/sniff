+use super::*;
+
+fn path() -> VfsPath {
+    VfsPath::new_virtual_path("/source.rs".to_owned())
+}
+
+#[test]
+fn exact_bytes_survive_draining_and_updates() {
+    let mut vfs = Vfs::with_source_snapshots();
+    let first = b"\xef\xbb\xbf// source\r\n\0\xff".to_vec();
+    assert!(vfs.set_file_contents(path(), Some(first.clone())));
+    let (id, _) = vfs.file_id(&path()).unwrap();
+    assert_eq!(vfs.source_snapshot(id), Some(first.as_slice()));
+    assert_eq!(vfs.take_changes().len(), 1);
+    assert_eq!(vfs.source_snapshot(id), Some(first.as_slice()));
+    assert!(!vfs.set_file_contents(path(), Some(first)));
+    assert!(vfs.take_changes().is_empty());
+    let second = b"fn next() {}".to_vec();
+    assert!(vfs.set_file_contents(path(), Some(second.clone())));
+    assert_eq!(vfs.source_snapshot(id), Some(second.as_slice()));
+    assert!(vfs.take_changes()[&id].is_modified());
+    assert_eq!(vfs.source_snapshot(id), Some(second.as_slice()));
+}
+
+#[test]
+fn create_modify_delete_and_recreate_merge_without_stale_snapshots() {
+    let mut vfs = Vfs::with_source_snapshots();
+    vfs.set_file_contents(path(), Some(b"one".to_vec()));
+    let (id, _) = vfs.file_id(&path()).unwrap();
+    vfs.set_file_contents(path(), Some(b"two".to_vec()));
+    assert_eq!(vfs.source_snapshot(id), Some(b"two".as_slice()));
+    assert_eq!(
+        vfs.take_changes()[&id].change,
+        Change::Create(b"two".to_vec(), hash_once::<FxHasher>(b"two"))
+    );
+    assert!(vfs.set_file_contents(path(), None));
+    assert!(vfs.file_id(&path()).is_none());
+    assert!(vfs.source_snapshot(id).is_none());
+    assert!(!vfs.set_file_contents(path(), None));
+    assert!(vfs.set_file_contents(path(), Some(b"three".to_vec())));
+    assert_eq!(vfs.file_id(&path()).unwrap().0, id);
+    assert_eq!(vfs.source_snapshot(id), Some(b"three".as_slice()));
+    assert!(vfs.take_changes()[&id].is_modified());
+}
+
+#[test]
+fn excluded_and_unknown_files_have_no_snapshot() {
+    let mut vfs = Vfs::with_source_snapshots();
+    assert!(vfs.source_snapshot(FileId::from_raw(42)).is_none());
+    vfs.set_file_contents(path(), Some(b"one".to_vec()));
+    let (id, _) = vfs.file_id(&path()).unwrap();
+    vfs.take_changes();
+    vfs.insert_excluded_file(path());
+    assert_eq!(vfs.file_id(&path()), Some((id, FileExcluded::Yes)));
+    assert!(vfs.source_snapshot(id).is_none());
+    assert!(!vfs.set_file_contents(path(), Some(b"two".to_vec())));
+    assert!(vfs.source_snapshot(id).is_none());
+    assert!(vfs.take_changes().is_empty());
+}
+
+#[test]
+fn capture_compares_bytes_even_when_cached_hash_matches() {
+    let mut vfs = Vfs::with_source_snapshots();
+    vfs.set_file_contents(path(), Some(b"old".to_vec()));
+    let (id, _) = vfs.file_id(&path()).unwrap();
+    vfs.take_changes();
+    // Simulate a hash collision without depending on FxHasher's implementation.
+    vfs.data[id.index() as usize] = FileState::Exists(hash_once::<FxHasher>(b"new"));
+    assert!(vfs.set_file_contents(path(), Some(b"new".to_vec())));
+    assert_eq!(vfs.source_snapshot(id), Some(b"new".as_slice()));
+    assert!(vfs.take_changes()[&id].is_modified());
+}
