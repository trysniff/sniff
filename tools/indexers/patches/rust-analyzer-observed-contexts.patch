+
+    #[test]
+    fn scip_cli_parses_the_explicit_observation_output() {
+        let args = ["scip", ".", "--sniff-project-model-output", "model.json"];
+        let flags =
+            crate::cli::flags::RustAnalyzer::from_vec(args.into_iter().map(Into::into).collect())
+                .unwrap();
+        let crate::cli::flags::RustAnalyzerCmd::Scip(scip) = flags.subcommand else {
+            panic!("SCIP subcommand was not parsed");
+        };
+        assert_eq!(scip.sniff_project_model_output, Some(PathBuf::from("model.json")));
+    }
+
+    #[test]
+    fn scip_cli_parses_the_explicit_backend_crate_selector() {
+        let args = [
+            "scip",
+            ".",
+            "--sniff-project-model-output",
+            "model.json",
+            "--sniff-crate-root",
+            "src/lib.rs",
+            "--sniff-crate-name",
+            "main",
+        ];
+        let flags =
+            crate::cli::flags::RustAnalyzer::from_vec(args.into_iter().map(Into::into).collect())
+                .unwrap();
+        let crate::cli::flags::RustAnalyzerCmd::Scip(scip) = flags.subcommand else {
+            panic!("SCIP subcommand was not parsed");
+        };
+        assert_eq!(scip.sniff_crate_root, Some(PathBuf::from("src/lib.rs")));
+        assert_eq!(scip.sniff_crate_name.as_deref(), Some("main"));
+    }
+
+    fn model(fixture: &str, paths: &[&str]) -> ObservedModel {
+        let (db, files) = RootDatabase::with_many_files(fixture);
+        let root =
+            AbsPathBuf::assert_utf8(std::env::temp_dir().join("sniff-compiler-context-unit"));
+        let mut vfs = Vfs::default();
+        assert_eq!(files.len(), paths.len());
+        for (file, path) in files.iter().zip(paths) {
+            let path = VfsPath::from(root.join(path));
+            vfs.set_file_contents(
+                path.clone(),
+                Some(db.file_text(file.file_id(&db)).text(&db).as_bytes().to_vec()),
+            );
+            assert_eq!(vfs.file_id(&path).unwrap().0, file.file_id(&db));
+        }
+        observed_model(&db, &vfs, &root).unwrap()
+    }
+
+    #[test]
+    fn backend_cfg_selects_modules_without_claiming_complete_world_domain() {
+        let model = model(
+            "//- /default/lib.rs crate:default\n#[cfg(feature = \"on\")] mod extra;\nfn active() {}\n//- /default/extra.rs\npub fn optional() {}\n//- /selected/lib.rs crate:selected cfg:feature=on\n#[cfg(feature = \"on\")] mod extra;\nfn active() {}\n//- /selected/extra.rs\npub fn optional() {}\n",
+            &["default/lib.rs", "default/extra.rs", "selected/lib.rs", "selected/extra.rs"],
+        );
+        let default = model
+            .crates
+            .iter()
+            .find(|context| context.identity.name.as_deref() == Some("default"))
+            .unwrap();
+        let selected = model
+            .crates
+            .iter()
+            .find(|context| context.identity.name.as_deref() == Some("selected"))
+            .unwrap();
+        assert_eq!(default.module_files.len(), 1);
+        assert_eq!(selected.module_files.len(), 2);
+        assert!(!default.inactive_ranges.is_empty());
+        assert!(selected.inactive_ranges.is_empty());
+        assert!(!model.declared_world_domain_complete);
+        assert!(!model.input_closure_proven);
+        let bytes = serde_json::to_vec(&model).unwrap();
+        let value: serde_json::Value = serde_json::from_slice(&bytes).unwrap();
+        assert_eq!(value["declared_world_domain_complete"], false);
+        assert_eq!(value["input_closure_proven"], false);
+    }
+
+    #[test]
+    fn test_cfg_comes_from_each_backend_crate_not_the_sniff_executable() {
+        let model = model(
+            "//- /normal.rs crate:normal\n#[cfg(test)] fn only_test() {}\n//- /tests.rs crate:tests cfg:test\n#[cfg(test)] fn only_test() {}\n",
+            &["normal.rs", "tests.rs"],
+        );
+        let normal = model
+            .crates
+            .iter()
+            .find(|context| context.identity.name.as_deref() == Some("normal"))
+            .unwrap();
+        let tests = model
+            .crates
+            .iter()
+            .find(|context| context.identity.name.as_deref() == Some("tests"))
+            .unwrap();
+        assert_eq!(normal.inactive_ranges.len(), 1);
+        assert_eq!(tests.inactive_ranges.len(), 0);
+        let inactive = &normal.inactive_ranges[0];
+        assert_eq!(inactive.start_byte, 0);
+        assert_eq!(inactive.end_byte, "#[cfg(test)] fn only_test() {}".len() as u32);
+    }
+
+    #[test]
+    fn macro_inactive_nodes_are_not_original_source_exclusion_proof() {
+        let model = model(
+            "//- /lib.rs crate:main\nmacro_rules! define { () => { #[cfg(any())] fn hidden() {} }; }\ndefine!();\nfn active() {}\n",
+            &["lib.rs"],
+        );
+        let context = &model.crates[0];
+        assert!(context.inactive_ranges.is_empty());
+        assert!(context.unmapped_inactive_ranges > 0);
+    }
+
+    #[test]
+    fn cfg_key_values_are_structured_and_deterministically_sorted() {
+        let model =
+            model("//- /lib.rs crate:main cfg:test,feature=on\nfn active() {}\n", &["lib.rs"]);
+        let facts = &model.crates[0].identity.analysis_cfg;
+        assert!(facts.contains(&CfgFact::Flag { name: "test".to_owned() }));
+        assert!(
+            facts
+                .contains(&CfgFact::KeyValue { key: "feature".to_owned(), value: "on".to_owned() })
+        );
+        assert!(facts.windows(2).all(|pair| pair[0] < pair[1]));
+    }
+
+    #[test]
+    fn inline_modules_do_not_duplicate_unmapped_macro_diagnostics() {
+        let model = model(
+            "//- /lib.rs crate:main\nmod outer { mod inner { macro_rules! define { () => { #[cfg(any())] fn hidden() {} }; } define!(); } }\n",
+            &["lib.rs"],
+        );
+        assert_eq!(model.crates[0].unmapped_inactive_ranges, 1);
+    }
+
+    #[test]
+    fn parser_failures_are_recorded_separately() {
+        let model = model("//- /lib.rs crate:main\nfn broken( {\n", &["lib.rs"]);
+        assert!(!model.crates[0].parser_errors.is_empty());
+        assert!(model.crates[0].repository_diagnostics_queried);
+        assert!(!model.crates[0].block_local_module_file_coverage_complete);
+    }
+
+    #[test]
+    fn colliding_relative_and_absolute_outputs_are_rejected() {
+        let dir = tempfile::tempdir().unwrap();
+        let path = dir.path().join("index.scip");
+        assert!(ObservedOutputs::prepare(&path, &dir.path().join(".").join("index.scip")).is_err());
+        assert!(!path.exists());
+    }
+
+    #[test]
+    fn successful_output_pair_is_bound_and_never_overwrites() {
+        let dir = tempfile::tempdir().unwrap();
+        let scip_path = dir.path().join("index.scip");
+        let model_path = dir.path().join("model.json");
+        let (db, files) = RootDatabase::with_many_files("//- /lib.rs crate:main\nfn active() {}\n");
+        let root = AbsPathBuf::assert_utf8(dir.path().to_path_buf());
+        let mut vfs = Vfs::default();
+        vfs.set_file_contents(
+            VfsPath::from(root.join("lib.rs")),
+            Some(db.file_text(files[0].file_id(&db)).text(&db).as_bytes().to_vec()),
+        );
+        ObservedOutputs::prepare(&scip_path, &model_path)
+            .unwrap()
+            .publish(scip::types::Index::default(), &db, &vfs, &root)
+            .unwrap();
+        let bytes = std::fs::read(&scip_path).unwrap();
+        let value: serde_json::Value =
+            serde_json::from_slice(&std::fs::read(&model_path).unwrap()).unwrap();
+        assert_eq!(value["scip_binding"]["byte_length"], bytes.len());
+        let checksum: String =
+            tenthash::hash(&bytes).iter().map(|byte| format!("{byte:02x}")).collect();
+        assert_eq!(value["scip_binding"]["tenthash_hex"], checksum);
+        assert_eq!(value["scip_binding"]["cryptographic_seal"], false);
+        assert_eq!(value["scip_binding"]["occurrence_context_selection"], "unavailable");
+        assert!(ObservedOutputs::prepare(&scip_path, &dir.path().join("new.json")).is_err());
+        assert_eq!(std::fs::read(&scip_path).unwrap(), bytes);
+    }
+
+    #[test]
+    fn raced_sidecar_destination_is_preserved_and_stages_are_cleaned() {
+        let dir = tempfile::tempdir().unwrap();
+        let scip_path = dir.path().join("index.scip");
+        let model_path = dir.path().join("model.json");
+        let outputs = ObservedOutputs::prepare(&scip_path, &model_path).unwrap();
+        std::fs::write(&model_path, b"existing").unwrap();
+        let (db, files) = RootDatabase::with_many_files("//- /lib.rs crate:main\nfn active() {}\n");
+        let root = AbsPathBuf::assert_utf8(dir.path().to_path_buf());
+        let mut vfs = Vfs::default();
+        vfs.set_file_contents(
+            VfsPath::from(root.join("lib.rs")),
+            Some(db.file_text(files[0].file_id(&db)).text(&db).as_bytes().to_vec()),
+        );
+        assert!(outputs.publish(scip::types::Index::default(), &db, &vfs, &root).is_err());
+        assert_eq!(std::fs::read(&model_path).unwrap(), b"existing");
+        assert!(scip_path.is_file());
+        assert_eq!(std::fs::read_dir(dir.path()).unwrap().count(), 2);
+    }
+}
