@@ -0,0 +1,213 @@
+use std::{fs, path::PathBuf};
+
+use project_model::{ManifestPath, ProjectWorkspaceKind, RustLibSource};
+
+use super::*;
+
+fn command(root: &AbsPath, program: &str, args: &[&str]) -> String {
+    let output = toolchain::command(program, root, &FxHashMap::default())
+        .env("CARGO_NET_OFFLINE", "true")
+        .env("CARGO_TARGET_DIR", root.join("target"))
+        .args(args)
+        .output()
+        .unwrap();
+    assert!(output.status.success(), "{program}: {}", String::from_utf8_lossy(&output.stderr));
+    String::from_utf8(output.stdout).unwrap().trim().to_owned()
+}
+
+fn fixture(extra_targets: &str) -> (temp_dir::TempDir, AbsPathBuf, CargoConfig) {
+    let dir = temp_dir::TempDir::with_prefix("sniff-native-source-roots").unwrap();
+    let root = AbsPathBuf::assert_utf8(dir.path().to_path_buf());
+    fs::create_dir_all(root.join("src")).unwrap();
+    fs::write(root.join("src/lib.rs"), "pub fn probe() {}\n").unwrap();
+    fs::write(
+        root.join("Cargo.toml"),
+        format!(
+            "[workspace]\n[package]\nname = \"sniff_source_probe\"\nversion = \"0.0.0\"\nedition = \"2024\"\n{extra_targets}"
+        ),
+    )
+    .unwrap();
+    command(&root, "cargo", &["generate-lockfile", "--offline"]);
+
+    // Use the real compiler identity with owned minimal sources, not installed stdlib proof.
+    let sysroot =
+        AbsPathBuf::assert_utf8(PathBuf::from(command(&root, "rustc", &["--print", "sysroot"])));
+    let library = root.join("owned-sysroot");
+    fs::create_dir_all(library.join("core/src")).unwrap();
+    fs::write(library.join("Cargo.toml"), "[workspace]\nmembers = [\"core\"]\nresolver = \"3\"\n")
+        .unwrap();
+    fs::write(
+        library.join("core/Cargo.toml"),
+        "[package]\nname = \"core\"\nversion = \"0.0.0\"\nedition = \"2024\"\n",
+    )
+    .unwrap();
+    fs::write(library.join("core/src/lib.rs"), "#![no_std]\n").unwrap();
+    command(&library, "cargo", &["generate-lockfile", "--offline"]);
+
+    let mut config = CargoConfig {
+        strict_discovery: true,
+        sysroot: Some(RustLibSource::Path(sysroot)),
+        sysroot_src: Some(library),
+        ..Default::default()
+    };
+    config.extra_env.insert("CARGO_NET_OFFLINE".to_owned(), Some("true".to_owned()));
+    config.extra_env.insert("CARGO_TARGET_DIR".to_owned(), Some(root.join("target").to_string()));
+    (dir, root, config)
+}
+
+fn workspace(root: &AbsPath, config: &CargoConfig) -> ProjectWorkspace {
+    let manifest = ManifestPath::try_from(root.join("Cargo.toml")).unwrap();
+    ProjectWorkspace::load(ProjectManifest::CargoToml(manifest), config, &|_| {}).unwrap()
+}
+
+fn load_config() -> LoadCargoConfig {
+    LoadCargoConfig {
+        load_out_dirs_from_check: false,
+        with_proc_macro_server: ProcMacroServerChoice::None,
+        prefill_caches: false,
+        num_worker_threads: 1,
+        proc_macro_processes: 1,
+    }
+}
+
+#[test]
+fn missing_metadata_target_roots_fail_before_database_application() {
+    let (_dir, root, config) = fixture(
+        r#"
+[[example]]
+name = "missing_first"
+path = "examples/missing_first.rs"
+[[example]]
+name = "missing_second"
+path = "examples/missing_second.rs"
+"#,
+    );
+    let ws = workspace(&root, &config);
+    let ProjectWorkspaceKind::Cargo { cargo, .. } = &ws.kind else {
+        panic!("expected Cargo metadata")
+    };
+    for name in ["missing_first", "missing_second"] {
+        assert!(cargo.target_by_root(&root.join(format!("examples/{name}.rs"))).is_some());
+    }
+    let (_, ordinary, _) = load_workspace(ws.clone(), &config.extra_env, &load_config()).unwrap();
+    assert!(ordinary.file_id(&VfsPath::from(root.join("src/lib.rs"))).is_some());
+
+    let mut db = RootDatabase::new(None);
+    let sentinel = FileId::from_raw(9000);
+    db.set_file_text(sentinel, "unchanged");
+    let Err(error) = load_workspace_into_db_with_source_policy(
+        ws,
+        &config.extra_env,
+        &load_config(),
+        &mut db,
+        true,
+    ) else {
+        panic!("strict loader must reject a partial target graph");
+    };
+    assert_eq!(
+        error.to_string(),
+        format!(
+            "could not load crate root sources; refusing a partial graph:\n{}\n{}",
+            root.join("examples/missing_first.rs").normalize(),
+            root.join("examples/missing_second.rs").normalize(),
+        )
+    );
+    assert_eq!(db.file_text(sentinel).text(&db).as_ref(), "unchanged");
+    assert!(ide_db::base_db::all_crates(&db).is_empty());
+}
+
+#[test]
+fn actual_loader_retains_workspace_and_owned_sysroot_bytes() {
+    let (_dir, root, config) = fixture("");
+    let bytes = "\u{feff}// \u{03bb}\r\npub fn probe() {}\r\n".as_bytes();
+    fs::write(root.join("src/lib.rs"), bytes).unwrap();
+    fs::write(root.join("src/inactive.rs"), "fn inactive() {}\n").unwrap();
+    let (db, vfs, _) = load_workspace_with_source_snapshots(
+        workspace(&root, &config),
+        &config.extra_env,
+        &load_config(),
+    )
+    .unwrap();
+    for (file, path) in vfs.iter() {
+        let captured = vfs.source_snapshot(file).unwrap();
+        assert_eq!(db.file_text(file).text(&db).as_bytes(), captured, "{path}");
+    }
+    for relative in ["src/lib.rs", "src/inactive.rs", "owned-sysroot/core/src/lib.rs"] {
+        let (file, excluded) = vfs.file_id(&VfsPath::from(root.join(relative))).unwrap();
+        assert_eq!(excluded, vfs::FileExcluded::No);
+        assert_eq!(vfs.source_snapshot(file).unwrap(), fs::read(root.join(relative)).unwrap());
+    }
+    let (file, _) = vfs.file_id(&VfsPath::from(root.join("src/lib.rs"))).unwrap();
+    assert_eq!(vfs.source_snapshot(file), Some(bytes));
+}
+
+#[test]
+fn actual_worker_invalid_utf8_is_not_silently_omitted() {
+    let (_dir, root, config) = fixture("");
+    fs::write(root.join("src/invalid.rs"), [0xff]).unwrap();
+    let ws = workspace(&root, &config);
+    load_workspace(ws.clone(), &config.extra_env, &load_config()).unwrap();
+    let Err(error) = load_workspace_with_source_snapshots(ws, &config.extra_env, &load_config())
+    else {
+        panic!("strict loader must reject invalid worker input");
+    };
+    let error = error.to_string();
+    assert!(error.contains("invalid.rs") && error.contains("UTF-8"), "{error}");
+}
+
+#[test]
+fn actual_worker_unavailable_source_is_not_silently_omitted() {
+    let (_dir, root, config) = fixture("");
+    let source = root.join("src/unreadable.rs");
+    #[cfg(windows)]
+    fs::write(&source, "fn unreadable() {}\n").unwrap();
+    #[cfg(unix)]
+    let _socket = std::os::unix::net::UnixListener::bind(&source).unwrap();
+    let ws = workspace(&root, &config);
+    #[cfg(windows)]
+    let _lock = {
+        use std::os::windows::fs::OpenOptionsExt;
+        fs::OpenOptions::new().read(true).share_mode(0).open(&source).unwrap()
+    };
+    assert!(fs::read(&source).is_err(), "fixture must actually deny the source read");
+    load_workspace(ws.clone(), &config.extra_env, &load_config()).unwrap();
+    let mut db = RootDatabase::new(None);
+    let sentinel = FileId::from_raw(9000);
+    db.set_file_text(sentinel, "unchanged");
+    let Err(error) = load_workspace_into_db_with_source_policy(
+        ws,
+        &config.extra_env,
+        &load_config(),
+        &mut db,
+        true,
+    ) else {
+        panic!("strict loader must reject unreadable worker input");
+    };
+    assert!(error.to_string().contains("unreadable.rs"), "{error}");
+    assert_eq!(db.file_text(sentinel).text(&db).as_ref(), "unchanged");
+    assert!(ide_db::base_db::all_crates(&db).is_empty());
+}
+
+#[test]
+fn virtual_workspace_without_optional_config_loads_exact_sources() {
+    let (_dir, root, config) = fixture("");
+    fs::create_dir_all(root.join("member/src")).unwrap();
+    fs::write(root.join("member/src/lib.rs"), "pub fn member() {}\n").unwrap();
+    fs::write(
+        root.join("member/Cargo.toml"),
+        "[package]\nname = \"sniff_source_probe\"\nversion = \"0.0.0\"\nedition = \"2024\"\n",
+    )
+    .unwrap();
+    fs::write(root.join("Cargo.toml"), "[workspace]\nmembers = [\"member\"]\nresolver = \"3\"\n")
+        .unwrap();
+    command(&root, "cargo", &["generate-lockfile", "--offline"]);
+    let (db, vfs, _) = load_workspace_with_source_snapshots(
+        workspace(&root, &config),
+        &config.extra_env,
+        &load_config(),
+    )
+    .unwrap();
+    let (file, _) = vfs.file_id(&VfsPath::from(root.join("member/src/lib.rs"))).unwrap();
+    assert_eq!(vfs.source_snapshot(file), Some(b"pub fn member() {}\n".as_slice()));
+    assert_eq!(db.file_text(file).text(&db).as_bytes(), b"pub fn member() {}\n");
+}
