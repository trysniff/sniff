+fn read_with_errors(
+    path: &AbsPath,
+    reject_non_regular: bool,
+    send_error: &impl Fn(std::path::PathBuf, String),
+) -> Option<Vec<u8>> {
+    let result = if reject_non_regular { read_regular(path) } else { fs::read(path) };
+    match result {
+        Ok(bytes) => Some(bytes),
+        Err(error) => {
+            send_error(path.to_path_buf().into(), error.to_string());
+            None
+        }
+    }
+}
+
+fn read_regular(path: &AbsPath) -> std::io::Result<Vec<u8>> {
+    use std::io::{Error, ErrorKind, Read};
+
+    if !fs::metadata(path)?.is_file() {
+        return Err(Error::new(ErrorKind::InvalidInput, "unsupported non-regular source input"));
+    }
+    let mut file = fs::File::open(path)?;
+    if !file.metadata()?.is_file() {
+        return Err(Error::new(ErrorKind::InvalidInput, "unsupported non-regular source input"));
+    }
+    let mut bytes = Vec::new();
+    file.read_to_end(&mut bytes)?;
+    Ok(bytes)
+}
+
+fn input_path(
+    path: std::path::PathBuf,
+    send_error: &impl Fn(std::path::PathBuf, String),
+) -> Option<AbsPathBuf> {
+    let path = match Utf8PathBuf::from_path_buf(path) {
+        Ok(path) => path,
+        Err(path) => {
+            send_error(path, "source path cannot be represented as UTF-8".to_owned());
+            return None;
+        }
+    };
+    match AbsPathBuf::try_from(path) {
+        Ok(path) => Some(path),
+        Err(path) => {
+            send_error(path.into_std_path_buf(), "source path is not absolute".to_owned());
+            None
+        }
+    }
