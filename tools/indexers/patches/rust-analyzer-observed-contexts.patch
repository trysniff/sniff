+#[test]
+fn strict_factory_disables_prefetch_and_lockfile_copy() {
+    let (_dir, root, manifest) = fixture(false);
+    let fetch = FetchMetadata::new(&manifest, &root, &config(true), &Sysroot::empty(), false);
+    assert!(fetch.no_deps_result.unwrap_err().to_string().contains("prefetch is disabled"));
+    assert!(fetch.lockfile_copy.is_none());
+    assert!(std::fs::metadata(root.join("Cargo.lock")).is_err());
+}
+
+#[test]
+fn strict_explicit_no_deps_is_rejected_before_execution() {
+    let (_dir, root, manifest) = fixture(false);
+    let fetch = FetchMetadata::new(&manifest, &root, &config(true), &Sysroot::empty(), true);
+    let error = fetch.exec(false, &|_| panic!("invalid invocation must not start")).unwrap_err();
+    assert!(error.to_string().contains("forbids explicit no-deps"));
+    assert!(std::fs::metadata(root.join("Cargo.lock")).is_err());
+}
