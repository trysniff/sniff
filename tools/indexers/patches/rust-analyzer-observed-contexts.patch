+            root: None,
+            rust_lib_src_root: None,
+            workspace: RustLibSrcWorkspace::Stitched(stitched),
+            error: None,
+        };
+        assert!(!sysroot.is_rust_lib_src_empty());
+        assert!(sysroot.error().is_none());
+        assert!(sysroot.metadata_error().is_none());
+        assert!(!sysroot.has_full_cargo_metadata());
+    }
