+//! Commit actual loaded source buffers, not reread files or an inferred input closure.
+
+use anyhow::{Context, Result, ensure};
+use ide::RootDatabase;
+use ide_db::{
+    FxHashSet,
+    base_db::{LibraryRoots, LocalRoots, SourceDatabase},
+};
+use serde_derive::Serialize;
+use sha2::{Digest, Sha256};
+use std::collections::BTreeSet;
+use vfs::{AbsPathBuf, Vfs};
+
+#[derive(Debug, PartialEq, Eq, Serialize)]
+pub(super) struct SourceBinding {
+    pub(super) file: String,
+    raw_byte_length: usize,
+    raw_sha256_hex: String,
+    analysis_byte_length: usize,
+    analysis_sha256_hex: String,
+}
+
+pub(super) fn sha256_hex(bytes: &[u8]) -> String {
+    format!("{:x}", Sha256::digest(bytes))
+}
+
+pub(super) fn source_bindings(db: &RootDatabase, vfs: &Vfs) -> Result<Vec<SourceBinding>> {
+    let mut analysis_files = FxHashSet::default();
+    for root in LocalRoots::get(db).roots(db).iter().chain(LibraryRoots::get(db).roots(db)) {
+        analysis_files.extend(db.source_root(*root).source_root(db).iter());
+    }
+    let mut loaded_files = FxHashSet::default();
+    let mut bindings = Vec::new();
+    for (file, path) in vfs.iter() {
+        let raw = vfs.source_snapshot(file).context("source bytes were not retained")?;
+        ensure!(analysis_files.contains(&file), "loaded source has no analysis input: {path}");
+        let analysis = db.file_text(file).text(db);
+        ensure!(raw == analysis.as_bytes(), "loaded source and analysis bytes differ: {path}");
+        let path = path.as_path().context("source binding requires a real file path")?;
+        loaded_files.insert(file);
+        bindings.push(SourceBinding {
+            file: path.to_string(),
+            raw_byte_length: raw.len(),
+            raw_sha256_hex: sha256_hex(raw),
+            analysis_byte_length: analysis.len(),
+            analysis_sha256_hex: sha256_hex(analysis.as_bytes()),
+        });
+    }
+    ensure!(loaded_files == analysis_files, "analysis source has no retained loaded buffer");
+    bindings.sort_by(|left, right| left.file.cmp(&right.file));
+    ensure!(
+        bindings.windows(2).all(|pair| pair[0].file != pair[1].file),
+        "duplicate source binding path"
+    );
+    Ok(bindings)
+}
+
+pub(super) fn validate_document_sources(
+    index: &scip::types::Index,
+    bindings: &[SourceBinding],
+    root: &AbsPathBuf,
+) -> Result<()> {
+    let files: BTreeSet<_> = bindings.iter().map(|binding| binding.file.as_str()).collect();
+    let mut documents = BTreeSet::new();
+    for document in &index.documents {
+        let relative = &document.relative_path;
+        ensure!(
+            !relative.contains('\\')
+                && !relative.split('/').next().unwrap_or_default().contains(':')
+                && relative.split('/').all(|part| !matches!(part, "" | "." | "..")),
+            "SCIP document path is not canonical repository-relative: {relative}"
+        );
+        ensure!(documents.insert(relative), "duplicate source-bound SCIP document: {relative}");
+        let path = root.join(relative).normalize();
+        ensure!(files.contains(path.as_str()), "SCIP document has no source binding: {relative}");
+    }
+    Ok(())
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use test_fixture::WithFixture;
