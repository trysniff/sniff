+    }
+
+    #[test]
+    fn valid_utf8_snapshot_preserves_bom_crlf_and_unicode() {
+        let bytes = "\u{feff}// \u{03bb}\r\nfn main() {}\r\n".as_bytes().to_vec();
+        let (result, db, vfs) = load_sources(vec![("/valid.rs", bytes.clone())], true, true);
+        result.unwrap();
+        let (id, _) = vfs.file_id(&VfsPath::new_virtual_path("/valid.rs".to_owned())).unwrap();
+        assert_eq!(vfs.source_snapshot(id), Some(bytes.as_slice()));
+        assert_eq!(db.file_text(id).text(&db).as_bytes(), bytes);
+    }
