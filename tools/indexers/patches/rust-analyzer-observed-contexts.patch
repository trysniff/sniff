+        assert_eq!(bindings.len(), 2);
+        assert!(bindings.windows(2).all(|pair| pair[0].file < pair[1].file));
+        for binding in &bindings {
+            assert_eq!(binding.raw_sha256_hex, binding.analysis_sha256_hex);
+            assert_eq!(binding.raw_byte_length, binding.analysis_byte_length);
+        }
+        assert_eq!(source_bindings(&db, &vfs).unwrap(), bindings);
+    }
+
+    #[test]
