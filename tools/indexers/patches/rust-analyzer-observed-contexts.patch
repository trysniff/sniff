+#[test]
+fn strict_options_reject_metadata_and_lockfile_escape_hatches() {
+    for args in [
+        vec!["--no-deps"],
+        vec!["--no-deps=true"],
+        vec!["--lockfile-path", "other.lock"],
+        vec!["--lockfile-path=other.lock"],
+        vec!["-Zlockfile-path"],
+        vec!["-Z", "lockfile-path"],
+        vec!["-Zunstable-options,lockfile-path=other.lock"],
+    ] {
+        let args = args.into_iter().map(str::to_owned).collect::<Vec<_>>();
+        assert!(validate_strict_metadata_options(&args, false).is_err());
+    }
+    assert!(validate_strict_metadata_options(&[], true).is_err());
+    assert!(
+        validate_strict_metadata_options(&["--offline".to_owned(), "--locked".to_owned()], false)
