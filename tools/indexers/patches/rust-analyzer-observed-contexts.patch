+
+fn validate_strict_metadata_options(
+    args: &[String],
+    redirected_lockfile: bool,
+) -> anyhow::Result<()> {
+    anyhow::ensure!(
+        !redirected_lockfile,
+        "strict metadata forbids lockfile redirection via environment"
+    );
+    for (index, arg) in args.iter().enumerate() {
+        anyhow::ensure!(
+            arg != "--no-deps" && !arg.starts_with("--no-deps="),
+            "strict metadata forbids no-deps arguments"
+        );
+        let unstable = if arg == "-Z" {
+            args.get(index + 1).map(String::as_str)
+        } else {
+            arg.strip_prefix("-Z")
+        };
+        anyhow::ensure!(
+            arg != "--lockfile-path"
+                && !arg.starts_with("--lockfile-path=")
+                && !unstable.is_some_and(|value| value
+                    .split(',')
+                    .any(|flag| flag.split('=').next() == Some("lockfile-path"))),
+            "strict metadata forbids lockfile redirection arguments"
+        );
+    }
+    Ok(())
+}
+
+fn validate_strict_metadata_config(
+    invocation: &std::process::Command,
+    args: &[String],
+) -> anyhow::Result<()> {
+    let dir = invocation
+        .get_current_dir()
+        .ok_or_else(|| anyhow::anyhow!("strict metadata requires an explicit working directory"))?;
+    anyhow::ensure!(dir.is_absolute(), "strict metadata working directory must be absolute");
+    let mut query = toolchain::command(invocation.get_program(), dir, &FxHashMap::default());
+    for (key, value) in invocation.get_envs() {
+        if let Some(value) = value {
+            query.env(key, value);
+        } else {
+            query.env_remove(key);
+        }
+    }
+    // Cargo's effective-config query is unstable even on the pinned stable toolchain.
+    query.env("RUSTC_BOOTSTRAP", "1").args([
+        "-Z",
+        "unstable-options",
+        "config",
+        "get",
+        "--format",
+        "json",
+    ]);
+    let mut args = args.iter();
+    while let Some(arg) = args.next() {
+        if arg == "--config" || arg == "-Z" {
+            let value = args
+                .next()
+                .ok_or_else(|| anyhow::anyhow!("missing Cargo configuration argument"))?;
+            query.arg(arg).arg(value);
+        } else if arg.starts_with("--config=") || arg.starts_with("-Z") {
+            query.arg(arg);
+        }
+    }
+    let output =
+        crate::utf8_stdout(&mut query).context("strict metadata effective-config query failed")?;
+    let config: serde_json::Value =
+        serde_json::from_str(&output).context("invalid strict metadata effective config")?;
+    anyhow::ensure!(config.is_object(), "strict metadata effective config must be an object");
+    anyhow::ensure!(
+        config.get("resolver").and_then(|resolver| resolver.get("lockfile-path")).is_none(),
+        "strict metadata forbids lockfile redirection via Cargo resolver config"
+    );
+    anyhow::ensure!(
+        config.get("env").and_then(|env| env.get("CARGO_RESOLVER_LOCKFILE_PATH")).is_none(),
+        "strict metadata forbids lockfile redirection via Cargo env config"
+    );
+    Ok(())
+}
