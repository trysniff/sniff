+//! Compiler-owned source associations, including body/block maps and include expansions.
+
+use hir::{Crate, MacroCallId};
+use hir_def::{
+    AdtId, DefWithBodyId, ExpressionStoreOwnerId, GenericDefId, ModuleDefId,
+    expr_store::ExpressionStore,
+    nameres::{
+        assoc::{ImplItems, TraitItems},
+        crate_def_map,
+    },
+};
+use ide::RootDatabase;
+use ide_db::{FxHashMap, FxHashSet};
+use vfs::FileId;
+
+fn queue_item(item: ModuleDefId, stores: &mut Vec<ExpressionStoreOwnerId>) {
+    let generic: GenericDefId = match item {
+        ModuleDefId::FunctionId(id) => id.into(),
+        ModuleDefId::StaticId(id) => id.into(),
+        ModuleDefId::ConstId(id) => id.into(),
+        ModuleDefId::AdtId(id) => id.into(),
+        ModuleDefId::TraitId(id) => id.into(),
+        ModuleDefId::TypeAliasId(id) => id.into(),
+        _ => return,
+    };
+    stores.push(generic.into());
+    match item {
+        ModuleDefId::FunctionId(id) => stores.push(DefWithBodyId::from(id).into()),
+        ModuleDefId::StaticId(id) => stores.push(DefWithBodyId::from(id).into()),
+        ModuleDefId::ConstId(id) => stores.push(DefWithBodyId::from(id).into()),
+        ModuleDefId::AdtId(AdtId::StructId(id)) => stores.push(hir_def::VariantId::from(id).into()),
+        ModuleDefId::AdtId(AdtId::UnionId(id)) => stores.push(hir_def::VariantId::from(id).into()),
+        _ => {}
+    }
+}
+
+fn record_include(
+    db: &RootDatabase,
+    call: MacroCallId,
+    includes: &mut FxHashMap<FileId, FxHashSet<MacroCallId>>,
+) {
+    if let Some(file) = call.loc(db).include_file_id(db, call) {
+        includes.entry(file.file_id(db)).or_default().insert(call);
+    }
+}
+
+pub(super) fn association_counts(db: &RootDatabase) -> FxHashMap<FileId, usize> {
+    hir::attach_db(db, || {
+        let mut direct = FxHashMap::<_, FxHashSet<_>>::default();
+        let mut includes = FxHashMap::<_, FxHashSet<_>>::default();
+        let mut maps = Crate::all(db)
+            .into_iter()
+            .map(|krate| crate_def_map(db, krate.base()))
+            .collect::<Vec<_>>();
+        let mut stores = Vec::new();
+        let mut visited_maps = FxHashSet::default();
+        let mut visited_stores = FxHashSet::default();
+        while !maps.is_empty() || !stores.is_empty() {
+            while let Some(map) = maps.pop() {
+                if !visited_maps.insert(map.root) {
+                    continue;
+                }
+                for (module_id, module) in map.modules() {
+                    if let Some(file) = module.origin.file_id() {
+                        direct.entry(file.file_id(db)).or_default().insert(module_id);
+                    }
+                    for call in module.scope.all_macro_calls() {
+                        record_include(db, call, &mut includes);
+                    }
+                    for id in module.scope.unnamed_consts() {
+                        queue_item(id.into(), &mut stores);
+                    }
+                    for item in module.scope.declarations() {
+                        queue_item(item, &mut stores);
+                        match item {
+                            ModuleDefId::TraitId(id) => {
+                                let items = &TraitItems::query_with_diagnostics(db, id).0;
+                                for (_, item) in &items.items {
+                                    queue_item((*item).into(), &mut stores);
+                                }
+                                for (_, call) in items.macro_calls() {
+                                    record_include(db, call, &mut includes);
+                                }
+                            }
+                            ModuleDefId::AdtId(AdtId::EnumId(id)) => {
+                                for &(variant, _) in id.enum_variants(db).variants.values() {
+                                    stores.push(DefWithBodyId::from(variant).into());
+                                    stores.push(hir_def::VariantId::from(variant).into());
+                                }
+                            }
+                            _ => {}
+                        }
+                    }
+                    for id in module.scope.impls() {
+                        stores.push(id.into());
+                        let items = &ImplItems::of(db, id).0;
+                        for (_, item) in &items.items {
+                            queue_item((*item).into(), &mut stores);
+                        }
+                        for (_, call) in items.macro_calls() {
+                            record_include(db, call, &mut includes);
+                        }
+                    }
+                }
+            }
+            while let Some(owner) = stores.pop() {
+                if !visited_stores.insert(owner) {
+                    continue;
+                }
+                let (store, sources) = ExpressionStore::with_source_map(db, owner);
+                maps.extend(store.blocks(db).map(|(_, map)| map));
+                for (_, call) in sources.macro_calls() {
+                    record_include(db, call, &mut includes);
+                }
+            }
+        }
+        let mut counts = direct
+            .into_iter()
+            .map(|(file, modules)| (file, modules.len()))
+            .collect::<FxHashMap<_, _>>();
+        for (file, calls) in includes {
+            *counts.entry(file).or_default() += calls.len();
+        }
+        counts
+    })
+}
