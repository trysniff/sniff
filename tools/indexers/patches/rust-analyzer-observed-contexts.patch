+//! Strict Cargo queries for Sniff observations, not a compiler-world closure proof.
+
+use std::{fs, process::Command};
+
+use anyhow::{Context, ensure};
+use base_db::target;
+use cfg::CfgAtom;
+use paths::{AbsPathBuf, Utf8PathBuf};
+use semver::Version;
+use toolchain::Tool;
+
+use crate::{
+    CargoConfig, CargoFeatures, ManifestPath, Sysroot,
+    cargo_config_file::CargoConfigFile,
+    cargo_workspace::RustLibSource,
+    toolchain_info::{target_data::TargetSpec, target_tuple},
+    utf8_stdout,
+};
+
+#[path = "sniff_discovery/layout.rs"]
+mod layout;
+
+pub(crate) struct Queries {
+    pub config: CargoConfigFile,
+    pub targets: Vec<String>,
+    pub version: Version,
+    pub cfg: Vec<CfgAtom>,
+    pub target: target::TargetData,
+}
+
+pub(crate) fn locate_workspace(
+    manifest: &ManifestPath,
+    config: &CargoConfig,
+    sysroot: &Sysroot,
+) -> anyhow::Result<ManifestPath> {
+    #[derive(serde::Deserialize)]
+    struct Root {
+        root: Utf8PathBuf,
+    }
+    let mut command = sysroot.tool(Tool::Cargo, manifest.parent(), &config.extra_env);
+    command.args(["locate-project", "--workspace", "--manifest-path", manifest.as_str()]);
+    append_config_args(&mut command, config)?;
+    let root: Root = serde_json::from_str(
+        &utf8_stdout(&mut command).context("strict Cargo workspace-root query failed")?,
+    )
+    .context("invalid strict Cargo workspace-root response")?;
+    let root = AbsPathBuf::try_from(root.root)
+        .map_err(|_| anyhow::anyhow!("Cargo workspace root must be absolute"))?;
+    ManifestPath::try_from(root)
+        .map_err(|_| anyhow::anyhow!("invalid strict Cargo workspace manifest"))
+}
+
+pub(crate) fn sysroot(manifest: &ManifestPath, config: &CargoConfig) -> anyhow::Result<Sysroot> {
+    let root = match &config.sysroot {
+        Some(RustLibSource::Discover) => {
+            let empty = Sysroot::empty();
+            let effective = effective_config(manifest, config, &empty)?;
+            let targets = targets(manifest, config, &empty, &effective)?;
+            AbsPathBuf::try_from(Utf8PathBuf::from(cargo_print(
+                manifest,
+                config,
+                &empty,
+                Some(&targets[0]),
+                "sysroot",
+            )?))
+            .map_err(|_| anyhow::anyhow!("strict sysroot query returned a nonabsolute path"))?
+        }
+        Some(RustLibSource::Path(path)) => path.clone(),
+        None => anyhow::bail!("strict discovery requires a sysroot"),
+    };
+    ensure!(
+        toolchain::probe_for_binary(root.join("bin/rustc").into()).is_some(),
+        "strict discovery requires rustc inside the selected sysroot"
+    );
+    let source_override = match config.extra_env.get("RUST_SRC_PATH") {
+        Some(value) => value.clone(),
+        None => std::env::var_os("RUST_SRC_PATH")
+            .map(|value| {
+                value.into_string().map_err(|_| anyhow::anyhow!("RUST_SRC_PATH must be UTF-8"))
+            })
+            .transpose()?,
+    };
+    let source = if let Some(source) = &config.sysroot_src {
+        source.clone()
+    } else if let Some(source) = source_override {
+        AbsPathBuf::try_from(source.as_str())
+            .map_err(|_| anyhow::anyhow!("RUST_SRC_PATH must be absolute"))?
+    } else {
+        root.join("lib/rustlib/src/rust/library")
+    };
+    ensure!(
+        fs::metadata(source.join("core/src/lib.rs")).is_ok(),
+        "strict discovery requires installed rust-src; no component installation or source-path recovery is attempted"
+    );
+    Ok(Sysroot::new(Some(root), Some(source)))
+}
+
+pub(crate) fn queries(
+    manifest: &ManifestPath,
+    config: &CargoConfig,
+    sysroot: &Sysroot,
+) -> anyhow::Result<Queries> {
+    let effective = effective_config(manifest, config, sysroot)?;
+    let targets = targets(manifest, config, sysroot, &effective)?;
+    if let Some(expected) = sysroot.root() {
+        let actual = cargo_print(manifest, config, sysroot, Some(&targets[0]), "sysroot")?;
+        let actual = AbsPathBuf::try_from(Utf8PathBuf::from(actual))
+            .map_err(|_| anyhow::anyhow!("Cargo compiler sysroot must be absolute"))?;
+        ensure!(
+            fs::canonicalize(&actual)? == fs::canonicalize(expected)?,
+            "selected sysroot differs from Cargo compiler sysroot"
+        );
+    }
+    let mut version_command = sysroot.tool(Tool::Cargo, manifest.parent(), &config.extra_env);
+    version_command.arg("--version");
+    let version = parse_version(&utf8_stdout(&mut version_command)?)?;
+    let cfg = parse_cfg(&cargo_print(manifest, config, sysroot, Some(&targets[0]), "cfg")?)?;
+    let target = parse_target(&cargo_print(
+        manifest,
+        config,
+        sysroot,
+        Some(&targets[0]),
+        "target-spec-json",
+    )?)?;
+    Ok(Queries { config: effective, targets, version, cfg, target })
+}
+
+fn effective_config(
+    manifest: &ManifestPath,
+    config: &CargoConfig,
+    sysroot: &Sysroot,
+) -> anyhow::Result<CargoConfigFile> {
+    let mut command = sysroot.tool(Tool::Cargo, manifest.parent(), &config.extra_env);
+    command.env("RUSTC_BOOTSTRAP", "1").args([
+        "-Z",
+        "unstable-options",
+        "config",
+        "get",
+        "--format",
+        "toml",
+        "--show-origin",
+    ]);
+    append_config_args(&mut command, config)?;
+    CargoConfigFile::from_strict_query(
+        utf8_stdout(&mut command).context("strict effective Cargo configuration query failed")?,
+    )
+}
+
+fn targets(
+    manifest: &ManifestPath,
+    config: &CargoConfig,
+    sysroot: &Sysroot,
+    effective: &CargoConfigFile,
+) -> anyhow::Result<Vec<String>> {
+    let targets = if let Some(target) = &config.target {
+        vec![target.clone()]
+    } else if let Some(targets) = target_tuple::parse_toml_cargo_config_build_target(effective)? {
+        targets
+    } else {
+        // Confirmed absence of build.target means Cargo's host default, not query failure.
+        vec![cargo_print(manifest, config, sysroot, None, "host-tuple")?]
+    };
+    ensure!(
+        targets.len() == 1,
+        "strict observations require exactly one target; select a target explicitly"
+    );
+    let target = &targets[0];
+    ensure!(
+        !target.is_empty()
+            && (target.ends_with(".json") || !target.chars().any(char::is_whitespace)),
+        "invalid strict Cargo target"
+    );
+    if target.ends_with(".json") && !std::path::Path::new(target).is_absolute() {
+        return Ok(vec![manifest.parent().join(target).to_string()]);
+    }
+    Ok(targets)
+}
+
+fn append_config_args(command: &mut Command, config: &CargoConfig) -> anyhow::Result<()> {
+    for source in [&config.extra_args, &config.metadata_extra_args] {
+        command.args(partition_args(source)?.0);
+    }
+    if let Some(path) = &config.config_path {
+        command.arg("--config").arg(path);
+    }
+    Ok(())
+}
+
+fn partition_args(source: &[String]) -> anyhow::Result<(Vec<String>, Vec<String>)> {
+    let mut selectors = Vec::new();
+    let mut remaining = Vec::new();
+    let mut args = source.iter();
+    while let Some(arg) = args.next() {
+        if arg == "--" {
+            remaining.push(arg.clone());
+            remaining.extend(args.cloned());
+            break;
+        }
+        if arg == "--config" || arg == "-Z" {
+            selectors.extend([
+                arg.clone(),
+                args.next().context("missing Cargo configuration argument")?.clone(),
+            ]);
+        } else if arg.starts_with("--config=") || arg.starts_with("-Z") {
+            selectors.push(arg.clone());
+        } else {
+            remaining.push(arg.clone());
+        }
+    }
+    Ok((selectors, remaining))
+}
+
+fn cargo_print(
+    manifest: &ManifestPath,
+    config: &CargoConfig,
+    sysroot: &Sysroot,
+    target: Option<&str>,
+    key: &str,
+) -> anyhow::Result<String> {
+    let mut command = sysroot.tool(Tool::Cargo, manifest.parent(), &config.extra_env);
+    command.env("RUSTC_BOOTSTRAP", "1").args([
+        "rustc",
+        "-Z",
+        "unstable-options",
+        "--locked",
+        "--manifest-path",
+        manifest.as_str(),
+        "--print",
+        key,
+    ]);
+    append_config_args(&mut command, config)?;
+    let remaining = partition_args(&config.extra_args)?.1;
+    let delimiter = remaining.iter().position(|arg| arg == "--");
+    command.args(&remaining[..delimiter.unwrap_or(remaining.len())]);
+    match &config.features {
+        CargoFeatures::All => {
+            command.arg("--all-features");
+        }
+        CargoFeatures::Selected { features, no_default_features } => {
+            if *no_default_features {
+                command.arg("--no-default-features");
+            }
+            if !features.is_empty() {
+                command.arg("--features").arg(features.join(","));
+            }
+        }
+    }
+    if let Some(target) = target {
+        command.arg("--target").arg(target);
+    }
+    if delimiter.is_some() || key == "target-spec-json" {
+        command.arg("--");
+        if let Some(delimiter) = delimiter {
+            command.args(&remaining[delimiter + 1..]);
+        }
+        if key == "target-spec-json" {
+            command.args(["-Z", "unstable-options"]);
+        }
+    }
+    utf8_stdout(&mut command)
+        .with_context(|| format!("strict Cargo {key} query failed; no rustc recovery"))
+}
+
+pub(crate) fn rustc_target_libdir(
+    manifest: &ManifestPath,
+    config: &CargoConfig,
+    sysroot: &Sysroot,
+    target: &str,
+) -> anyhow::Result<String> {
+    cargo_print(manifest, config, sysroot, Some(target), "target-libdir")
+}
+
+fn parse_version(output: &str) -> anyhow::Result<Version> {
+    let version = output
+        .strip_prefix("cargo ")
+        .and_then(|value| value.split_whitespace().next())
+        .context("strict Cargo version output is invalid")?;
+    Version::parse(version).context("strict Cargo version is not semver")
+}
+
+fn parse_cfg(output: &str) -> anyhow::Result<Vec<CfgAtom>> {
+    let cfg = output
+        .lines()
+        .map(|line| {
+            let key = line.split('=').next().unwrap_or_default();
+            ensure!(ra_ap_rustc_lexer::is_ident(key), "invalid strict compiler cfg key");
+            if let Some((_, value)) = line.split_once('=') {
+                let value = value
+                    .strip_prefix('"')
+                    .and_then(|value| value.strip_suffix('"'))
+                    .context("invalid strict compiler cfg value")?;
+                let mut decoded = String::new();
+                let mut error = None;
+                rustc_literal_escaper::unescape_str(value, |_, result| match result {
+                    Ok(ch) => decoded.push(ch),
+                    Err(err) => error = Some(err),
+                });
+                ensure!(error.is_none(), "invalid strict compiler cfg escape: {error:?}");
+                Ok(CfgAtom::KeyValue {
+                    key: intern::Symbol::intern(key),
+                    value: intern::Symbol::intern(&decoded),
+                })
+            } else {
+                Ok(CfgAtom::Flag(intern::Symbol::intern(key)))
+            }
+        })
+        .collect::<anyhow::Result<Vec<_>>>()?;
+    ensure!(!cfg.is_empty(), "strict compiler cfg query returned no cfgs");
+    Ok(cfg)
+}
+
+fn parse_target(output: &str) -> anyhow::Result<target::TargetData> {
+    let spec: TargetSpec =
+        serde_json::from_str(output).context("invalid strict compiler target specification")?;
+    ensure!(!spec.data_layout.is_empty(), "strict compiler target data layout is empty");
+    layout::validate(&spec.data_layout)?;
+    ra_ap_rustc_abi::TargetDataLayout::parse_from_llvm_datalayout_string(
+        &spec.data_layout,
+        ra_ap_rustc_abi::AddressSpace::ZERO,
+    )
+    .map_err(|_| {
+        anyhow::anyhow!("invalid strict compiler target layout: {:?}", spec.data_layout)
+    })?;
+    Ok(target::TargetData {
+        arch: spec.arch.into(),
+        data_layout: spec.data_layout.into_boxed_str(),
+    })
+}
