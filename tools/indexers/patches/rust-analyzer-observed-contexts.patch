@@ -0,0 +1,94 @@
+//! Check components the borrowed ABI parser ignores rather than accepting unknown defaults.
+
+use anyhow::{Context, ensure};
+
+pub(super) fn validate(layout: &str) -> anyhow::Result<()> {
+    for component in layout.split('-') {
+        let fields = component.split(':').collect::<Vec<_>>();
+        let first = fields[0];
+        match fields.as_slice() {
+            ["e" | "E"] => {}
+            ["m", mode] => ensure!(
+                matches!(*mode, "e" | "l" | "m" | "o" | "x" | "w" | "a"),
+                "invalid compiler layout mangling"
+            ),
+            ["ni", spaces @ ..] => {
+                ensure!(!spaces.is_empty(), "empty non-integral address-space list");
+                for space in spaces {
+                    number(space, 24, false)?;
+                }
+            }
+            [value] if value.starts_with(['P', 'G', 'A']) => {
+                number(&value[1..], 24, true)?;
+            }
+            [value] if value.starts_with('S') => {
+                alignment(&value[1..], false)?;
+            }
+            [value] if value.starts_with("Fi") || value.starts_with("Fn") => {
+                alignment(&value[2..], false)?;
+            }
+            ["a", alignments @ ..] => {
+                alignments_valid(alignments, true)?;
+            }
+            [value, alignments @ ..] if value.starts_with(['i', 'f', 'v']) => {
+                let size = number(&value[1..], 24, false)?;
+                let abi = alignments_valid(alignments, false)?;
+                ensure!(!value.starts_with('i') || size != 8 || abi == 8, "invalid i8 alignment");
+            }
+            [value, widths @ ..] if value.starts_with('n') => {
+                number(&value[1..], 24, false)?;
+                for width in widths {
+                    number(width, 24, false)?;
+                }
+            }
+            [value, values @ ..] if value.starts_with('p') => {
+                let space = &value[1..];
+                if !space.is_empty() {
+                    number(space, 24, true)?;
+                }
+                ensure!((2..=4).contains(&values.len()), "invalid pointer layout field count");
+                let size = number(values[0], 24, false)?;
+                ensure!(size % 8 == 0, "non-byte pointer size is unsupported by the ABI backend");
+                alignments_valid(&values[1..values.len().min(3)], false)?;
+                if values.len() == 4 {
+                    let index = number(values[3], 24, false)?;
+                    ensure!(
+                        index % 8 == 0,
+                        "non-byte pointer index is unsupported by the ABI backend"
+                    );
+                    ensure!(index <= size, "pointer index exceeds size");
+                }
+            }
+            _ => anyhow::bail!("unknown or unsupported compiler layout component: {first:?}"),
+        }
+    }
+    Ok(())
+}
+
+fn number(value: &str, bits: u32, zero: bool) -> anyhow::Result<u32> {
+    ensure!(
+        !value.is_empty() && value.bytes().all(|byte| byte.is_ascii_digit()),
+        "invalid compiler layout number"
+    );
+    let value = value.parse::<u32>().context("compiler layout number overflow")?;
+    ensure!(value < (1 << bits) && (zero || value != 0), "compiler layout number out of range");
+    Ok(value)
+}
+
+fn alignment(value: &str, zero: bool) -> anyhow::Result<u32> {
+    let value = number(value, 16, zero)?;
+    ensure!(
+        value == 0 || value >= 8 && value.is_power_of_two(),
+        "invalid compiler layout alignment"
+    );
+    Ok(value)
+}
+
+fn alignments_valid(values: &[&str], aggregate: bool) -> anyhow::Result<u32> {
+    ensure!((1..=2).contains(&values.len()), "invalid compiler layout alignment field count");
+    let abi = alignment(values[0], aggregate)?;
+    if values.len() == 2 {
+        ensure!(alignment(values[1], false)? >= abi.max(8), "preferred alignment is below ABI");
+    }
+    Ok(abi)
+}
