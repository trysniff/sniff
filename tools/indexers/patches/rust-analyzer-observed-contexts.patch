+            .publish(index, &db, &vfs, &root)
+            .unwrap();
+        let model: serde_json::Value =
+            serde_json::from_slice(&std::fs::read(model_path).unwrap()).unwrap();
+        assert_eq!(model["selected_root_context"]["name"], "two");
+        assert_eq!(
+            model["scip_binding"]["occurrence_context_selection"],
+            "selected-crate-closure-unique-source-associations"
+        );
+        assert_eq!(model["scip_binding"]["document_contexts"][0]["relative_path"], "shared.rs");
+        assert_eq!(model["scip_binding"]["document_contexts"][0]["context"]["name"], "two");
+        assert_eq!(model["scip_binding"]["symbol_context_namespaces"].as_array().unwrap().len(), 1);
+        assert_eq!(model["scip_binding"]["symbol_context_namespaces"][0]["context"]["name"], "two");
+        assert!(
+            model["scip_binding"]["symbol_context_namespaces"][0]["namespace"]
+                .as_str()
+                .unwrap()
+                .starts_with("sniff-context-")
+        );
+        assert_eq!(model["declared_world_domain_complete"], false);
+        assert_eq!(model["input_closure_proven"], false);
+    }
+
+    #[test]
+    fn direct_module_and_include_are_competing_source_contexts() {
+        let (mut db, vfs, root) = fixture(
+            "//- /lib.rs crate:main\n#[rustc_builtin_macro] macro_rules! include { () => {} }\n#[path = \"shared.rs\"] mod direct;\nmod injected { include!(\"shared.rs\"); }\n//- /shared.rs\npub fn api() {}\n",
+            &["lib.rs", "shared.rs"],
+        );
+        select_crate(&mut db, &vfs, &root.join("lib.rs"), "main").unwrap();
+        let file = vfs.file_id(&VfsPath::from(root.join("shared.rs"))).unwrap().0;
+        let counts = super::super::sniff_source_context::association_counts(&db);
+        assert_eq!(counts.get(&file), Some(&2));
+        assert!(document_owner_with_counts(&db, file, &counts).is_err());
+    }
+
+    #[test]
+    fn associated_method_block_modules_compete_with_direct_modules() {
+        let (mut db, vfs, root) = fixture(
+            "//- /lib.rs crate:main\n#[path = \"shared.rs\"] mod direct;\ntrait Api { fn work() { #[path = \"shared.rs\"] mod nested; } }\n//- /shared.rs\npub fn api() {}\n",
+            &["lib.rs", "shared.rs"],
+        );
+        select_crate(&mut db, &vfs, &root.join("lib.rs"), "main").unwrap();
+        let file = vfs.file_id(&VfsPath::from(root.join("shared.rs"))).unwrap().0;
+        let counts = super::super::sniff_source_context::association_counts(&db);
+        assert_eq!(counts.get(&file), Some(&2));
+        assert!(document_owner_with_counts(&db, file, &counts).is_err());
+    }
+
+    #[test]
+    fn duplicated_macro_argument_preserves_both_backend_definitions() {
+        let source = "macro_rules! twice { ($name:ident) => { mod a { pub struct $name; } mod b { pub struct $name; } }; } twice!(S);\n";
+        let (mut db, vfs, root) =
+            fixture(&format!("//- /lib.rs crate:main\n{source}"), &["lib.rs"]);
+        let selected = select_crate(&mut db, &vfs, &root.join("lib.rs"), "main").unwrap();
+        let host = AnalysisHost::with_database(db);
+        let analysis = host.analysis();
+        let index = StaticIndex::compute_with_all_macro_associations(
+            &analysis,
+            VendoredLibrariesConfig::Excluded,
+        );
+        let definitions = index
+            .tokens
+            .iter_ref()
+            .filter(|(_, token)| token.display_name.as_deref() == Some("S"))
+            .collect::<Vec<_>>();
+        assert_eq!(definitions.len(), 2);
+        assert!(definitions.iter().all(|(_, token)| token.definition_crate == Some(selected)));
+        let offset = source.rfind('S').unwrap() as u32;
+        assert_eq!(
+            index.files[0]
+                .tokens
+                .iter()
+                .filter(|(range, _)| u32::from(range.start()) == offset)
+                .count(),
+            2
+        );
+    }
+
+    #[test]
+    fn signature_field_discriminant_and_unnamed_const_blocks_are_not_omitted() {
+        for declaration in [
+            "const _: () = { #[path = \"shared.rs\"] mod nested; };",
+            "type Alias = [u8; { #[path = \"shared.rs\"] mod nested; 0 }];",
+            "struct Holder { value: [u8; { #[path = \"shared.rs\"] mod nested; 0 }] }",
+            "enum Choice { A = { #[path = \"shared.rs\"] mod nested; 0 } }",
+            "struct Api; impl Api { fn work() { #[path = \"shared.rs\"] mod nested; } }",
+        ] {
+            let (mut db, vfs, root) = fixture(
+                &format!(
+                    "//- /lib.rs crate:main\n#[path = \"shared.rs\"] mod direct;\n{declaration}\n//- /shared.rs\npub fn api() {{}}\n"
+                ),
+                &["lib.rs", "shared.rs"],
+            );
+            select_crate(&mut db, &vfs, &root.join("lib.rs"), "main").unwrap();
+            let file = vfs.file_id(&VfsPath::from(root.join("shared.rs"))).unwrap().0;
+            let counts = super::super::sniff_source_context::association_counts(&db);
+            assert_eq!(counts.get(&file), Some(&2), "{declaration}");
+            assert!(document_owner_with_counts(&db, file, &counts).is_err(), "{declaration}");
+        }
+    }
+}
diff --git a/crates/rust-analyzer/src/cli/sniff_project_model.rs b/crates/rust-analyzer/src/cli/sniff_project_model.rs
