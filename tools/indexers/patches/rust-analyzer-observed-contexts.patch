+        assert!(error.to_string().contains("failed.rs"), "{error}");
+        assert!(error.to_string().contains("read failure"), "{error}");
+        assert_eq!(db.file_text(sentinel).text(&db).as_ref(), "unchanged");
+        assert!(ide_db::base_db::all_crates(&db).is_empty());
+    }
+
+    #[test]
+    fn unavailable_worker_bytes_fail_before_database_application() {
+        let mut vfs = vfs::Vfs::with_source_snapshots();
+        let path = AbsPathBuf::assert_utf8(std::env::temp_dir().join("unavailable.rs"));
+        let (sender, receiver) = unbounded();
+        sender.send(vfs::loader::Message::Loaded { files: vec![(path, None)] }).unwrap();
+        sender
+            .send(vfs::loader::Message::Progress {
+                n_total: 1,
+                n_done: LoadingProgress::Finished,
+                dir: None,
+                config_version: 0,
+            })
+            .unwrap();
+        drop(sender);
+        let mut db = RootDatabase::new(None);
+        let sentinel = FileId::from_raw(9000);
+        db.set_file_text(sentinel, "unchanged");
+        let error = load_crate_graph_into_db(
+            CrateGraphBuilder::default(),
+            ProcMacrosBuilder::default(),
+            SourceRootConfig::default(),
+            &mut vfs,
+            &receiver,
+            &mut db,
+            true,
+        )
+        .unwrap_err();
+        assert!(error.to_string().contains("unavailable.rs"), "{error}");
+        assert_eq!(db.file_text(sentinel).text(&db).as_ref(), "unchanged");
+    }
+
+    fn load_sources(
+        sources: Vec<(&str, Vec<u8>)>,
+        retain_sources: bool,
+        finished: bool,
+    ) -> (anyhow::Result<()>, RootDatabase, vfs::Vfs) {
+        let mut vfs =
+            if retain_sources { vfs::Vfs::with_source_snapshots() } else { vfs::Vfs::default() };
+        for (path, contents) in sources {
+            vfs.set_file_contents(VfsPath::new_virtual_path(path.to_owned()), Some(contents));
+        }
+        let (sender, receiver) = unbounded();
+        if finished {
+            sender
+                .send(vfs::loader::Message::Progress {
+                    n_total: 0,
+                    n_done: LoadingProgress::Finished,
+                    dir: None,
+                    config_version: 0,
+                })
+                .unwrap();
+        }
+        drop(sender);
+        let mut db = RootDatabase::new(None);
+        for (id, _) in vfs.iter() {
+            db.set_file_text(id, "unchanged");
+        }
+        let result = load_crate_graph_into_db(
+            CrateGraphBuilder::default(),
+            ProcMacrosBuilder::default(),
+            SourceRootConfig::default(),
+            &mut vfs,
+            &receiver,
+            &mut db,
+            retain_sources,
+        );
+        (result, db, vfs)
+    }
+
+    #[test]
+    fn invalid_utf8_fails_before_analysis_changes_are_applied() {
