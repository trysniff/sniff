+    fs::write(root.join("lib/rustlib/src/rust/library/core/src/lib.rs"), "").unwrap();
+    config.extra_env.insert("RUST_SRC_PATH".to_owned(), Some(root.join("missing").to_string()));
+    assert!(sysroot(&manifest, &config).is_err());
