+fn config(strict_metadata: bool) -> CargoMetadataConfig {
+    let mut config = CargoMetadataConfig { strict_metadata, ..Default::default() };
+    config.extra_env.insert("CARGO_NET_OFFLINE".to_owned(), Some("true".to_owned()));
+    config.toolchain_version = Some(semver::Version::new(1, 96, 0));
+    config
+}
