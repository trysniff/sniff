new file mode 100644
index 0000000..7f7ecc4
--- /dev/null
+++ b/crates/load-cargo/src/source_snapshots.rs
@@ -0,0 +1,233 @@
+use super::*;
+
+#[cfg(test)]
+mod native_tests;
+
+/// Load analysis and retain the exact source buffers supplied by the loader.
+/// Invalid UTF-8 or an unfinished loader must fail, not silently omit input.
+/// This does not establish completeness of the compiler's input closure.
+pub fn load_workspace_with_source_snapshots(
+    ws: ProjectWorkspace,
+    extra_env: &FxHashMap<String, Option<String>>,
+    load_config: &LoadCargoConfig,
+) -> anyhow::Result<(RootDatabase, vfs::Vfs, Option<ProcMacroClient>)> {
+    let lru_cap = std::env::var("RA_LRU_CAP").ok().and_then(|it| it.parse::<u16>().ok());
+    let mut db = RootDatabase::new(lru_cap);
+    let (vfs, server) =
+        load_workspace_into_db_with_source_policy(ws, extra_env, load_config, &mut db, true)?;
+    Ok((db, vfs, server))
+}
+
+pub(super) fn apply_source_changes(
+    vfs: &mut vfs::Vfs,
+    change: &mut ChangeWithProcMacros,
+    retain_sources: bool,
+) -> anyhow::Result<()> {
+    for (_, file) in vfs.take_changes() {
+        match file.change {
+            vfs::Change::Create(bytes, _) | vfs::Change::Modify(bytes, _) => {
+                if retain_sources {
+                    anyhow::ensure!(
+                        vfs.source_snapshot(file.file_id) == Some(bytes.as_slice()),
+                        "source snapshot does not match loaded bytes for {}",
+                        vfs.file_path(file.file_id)
+                    );
+                }
+                match String::from_utf8(bytes) {
+                    Ok(text) => change.change_file(file.file_id, Some(text)),
+                    Err(error) if retain_sources => anyhow::bail!(
+                        "invalid UTF-8 source {}: {error}",
+                        vfs.file_path(file.file_id)
+                    ),
+                    Err(_) => {}
+                }
+            }
+            vfs::Change::Delete if retain_sources => change.change_file(file.file_id, None),
+            vfs::Change::Delete => {}
+        }
+    }
+    Ok(())
+}
+
+pub(super) fn optional_input_is_present(path: &AbsPathBuf) -> bool {
+    // Only declared optional config inputs use this gate. A present object,
+    // dangling link, or inspection error must still reach strict loading.
+    !matches!(std::fs::symlink_metadata(path), Err(error) if error.kind() == std::io::ErrorKind::NotFound)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn optional_inputs_omit_only_absent_files_not_present_objects() {
+        let dir = temp_dir::TempDir::with_prefix("sniff-optional-inputs").unwrap();
+        let root = AbsPathBuf::assert_utf8(dir.path().to_path_buf());
+        let path = root.join("rust-analyzer.toml");
+        assert!(!optional_input_is_present(&path));
+        std::fs::create_dir(&path).unwrap();
+        assert!(optional_input_is_present(&path));
+    }
+
+    #[test]
+    fn worker_load_error_fails_before_database_application() {
+        let mut vfs = vfs::Vfs::with_source_snapshots();
+        let path = AbsPathBuf::assert_utf8(std::env::temp_dir().join("failed.rs"));
+        vfs.set_file_contents(VfsPath::from(path.clone()), Some(b"fn pending() {}".to_vec()));
+        let (sender, receiver) = unbounded();
+        sender
+            .send(vfs::loader::Message::LoadError {
+                path: path.into(),
