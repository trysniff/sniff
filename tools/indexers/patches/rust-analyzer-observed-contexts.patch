+        assert!(error.contains("invalid.rs"), "{error}");
+        assert!(error.contains("UTF-8"), "{error}");
+        let (first, _) = vfs.file_id(&VfsPath::new_virtual_path("/first.rs".to_owned())).unwrap();
+        assert_eq!(db.file_text(first).text(&db).as_ref(), "unchanged");
+        let (id, _) = vfs.file_id(&VfsPath::new_virtual_path("/invalid.rs".to_owned())).unwrap();
+        assert_eq!(vfs.source_snapshot(id), Some([0xff].as_slice()));
+    }
+
+    #[test]
+    fn unfinished_loader_is_not_a_complete_snapshot() {
