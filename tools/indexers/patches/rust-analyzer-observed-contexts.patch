+use super::*;
+use vfs::loader::Handle;
+
+fn fixture() -> (temp_dir::TempDir, AbsPathBuf) {
+    let dir = temp_dir::TempDir::with_prefix("sniff-native-loader-errors").unwrap();
+    let root = AbsPathBuf::assert_utf8(dir.path().to_path_buf());
+    (dir, root)
+}
+
+fn messages(entries: Vec<loader::Entry>, strict: bool) -> Vec<loader::Message> {
+    let (sender, receiver) = unbounded();
+    let mut handle = if strict {
+        NotifyHandle::spawn_with_load_errors(sender)
+    } else {
+        NotifyHandle::spawn(sender)
+    };
+    handle.set_config(loader::Config { version: 0, load: entries, watch: vec![] });
+    let mut messages = Vec::new();
+    loop {
+        let message = receiver.recv_timeout(std::time::Duration::from_secs(30)).unwrap();
+        let finished =
+            matches!(&message, loader::Message::Progress { n_done: LoadingProgress::Finished, .. });
+        messages.push(message);
+        if finished {
+            break;
+        }
+    }
+    messages
+}
+
+fn errors(messages: &[loader::Message]) -> Vec<(&Path, &str)> {
+    messages
+        .iter()
+        .filter_map(|message| match message {
+            loader::Message::LoadError { path, message } => {
+                Some((path.as_path(), message.as_str()))
+            }
+            _ => None,
+        })
+        .collect()
+}
+
+#[test]
+fn valid_initial_loading_retains_bytes_without_errors() {
+    let (_dir, root) = fixture();
+    let source = root.join("source.rs");
+    let bytes = b"fn source() {}\r\n";
+    fs::write(&source, bytes).unwrap();
+    let messages = messages(vec![loader::Entry::rs_files_recursively(root)], true);
+    assert!(errors(&messages).is_empty());
+    let files: Vec<_> = messages
+        .iter()
+        .filter_map(|message| match message {
+            loader::Message::Loaded { files } => Some(files),
+            _ => None,
+        })
+        .flatten()
+        .collect();
+    assert_eq!(files.len(), 1);
+    assert_eq!(files[0].0, source);
+    assert_eq!(files[0].1.as_deref(), Some(bytes.as_slice()));
+}
+
+#[test]
+fn missing_directory_is_reported_before_finished() {
+    let (_dir, root) = fixture();
+    let missing = root.join("missing");
+    let messages = messages(vec![loader::Entry::rs_files_recursively(missing.clone())], true);
+    let errors = errors(&messages);
+    assert_eq!(errors.len(), 1);
+    assert_eq!(errors[0].0, AsRef::<Path>::as_ref(&missing));
+    assert!(!errors[0].1.is_empty());
+    assert!(matches!(
+        messages.last(),
+        Some(loader::Message::Progress { n_done: LoadingProgress::Finished, .. })
+    ));
+}
+
+#[test]
+fn explicit_file_read_failure_reports_native_path() {
+    let (_dir, root) = fixture();
+    let messages = messages(vec![loader::Entry::Files(vec![root.clone()])], true);
+    let errors = errors(&messages);
+    assert_eq!(errors.len(), 1);
+    assert_eq!(errors[0].0, AsRef::<Path>::as_ref(&root));
+    assert!(!errors[0].1.is_empty());
+}
+
+#[test]
+fn ordinary_loading_keeps_existing_omission_behavior() {
+    let (_dir, root) = fixture();
+    let file_root = root.join("source.rs");
+    fs::write(&file_root, "fn ordinary() {}\n").unwrap();
+    let missing = root.join("missing");
+    let messages = messages(
+        vec![
+            loader::Entry::rs_files_recursively(missing.clone()),
+            loader::Entry::Files(vec![root, missing]),
+            loader::Entry::rs_files_recursively(file_root.clone()),
+        ],
+        false,
+    );
+    assert!(errors(&messages).is_empty());
+    assert!(messages.iter().any(|message| match message {
+        loader::Message::Loaded { files } =>
+            files.iter().any(|(path, bytes)| path == &file_root && bytes.is_some()),
+        _ => false,
+    }));
+}
+
+#[test]
+fn non_directory_root_does_not_become_empty_success() {
+    let (_dir, root) = fixture();
+    let source = root.join("sources");
+    fs::write(&source, "not a directory\n").unwrap();
+    let messages = messages(vec![loader::Entry::rs_files_recursively(source.clone())], true);
+    let errors = errors(&messages);
+    assert_eq!(errors.len(), 1);
+    assert_eq!(errors[0].0, AsRef::<Path>::as_ref(&source));
+    assert!(errors[0].1.contains("directory"));
+}
+
+#[test]
+fn explicitly_excluded_non_directory_root_is_not_an_input_failure() {
+    let (_dir, root) = fixture();
+    let source = root.join("sources");
+    fs::write(&source, "excluded object\n").unwrap();
+    let entry = loader::Entry::Directories(loader::Directories {
+        extensions: vec!["rs".to_owned()],
+        include: vec![source.clone()],
+        exclude: vec![source],
+    });
+    let messages = messages(vec![entry], true);
+    assert!(errors(&messages).is_empty(), "{:?}", errors(&messages));
+}
+
+#[test]
+fn excluded_directories_are_not_loaded() {
+    let (_dir, root) = fixture();
+    let excluded = root.join("excluded");
+    fs::create_dir(&excluded).unwrap();
+    fs::write(excluded.join("ignored.rs"), "fn ignored() {}\n").unwrap();
+    let mut entry = loader::Entry::rs_files_recursively(root);
+    let loader::Entry::Directories(dirs) = &mut entry else { panic!("expected directories") };
+    dirs.exclude.push(excluded);
+    let messages = messages(vec![entry], true);
+    assert!(errors(&messages).is_empty());
+    assert!(messages.iter().all(|message| match message {
+        loader::Message::Loaded { files } => files.is_empty(),
+        _ => true,
+    }));
+}
+
+#[test]
+fn non_absolute_paths_are_reported_without_substitution() {
+    let errors = std::cell::RefCell::new(Vec::new());
+    let path = std::path::PathBuf::from("relative.rs");
+    assert!(
+        input_path(path.clone(), &|path, message| errors.borrow_mut().push((path, message)))
+            .is_none()
+    );
+    assert_eq!(errors.borrow().as_slice(), &[(path, "source path is not absolute".to_owned())]);
+}
+
+#[test]
+fn unrepresentable_paths_are_reported_without_lossy_identity() {
+    let errors = std::cell::RefCell::new(Vec::new());
+    #[cfg(unix)]
+    let name = {
+        use std::os::unix::ffi::OsStringExt;
+        std::ffi::OsString::from_vec(b"bad\xff.rs".to_vec())
+    };
+    #[cfg(windows)]
+    let name = {
+        use std::os::windows::ffi::OsStringExt;
+        std::ffi::OsString::from_wide(&[0xd800, 0x2e, 0x72, 0x73])
+    };
+    let path = std::env::temp_dir().join(name);
+    assert!(
+        input_path(path.clone(), &|path, message| errors.borrow_mut().push((path, message)))
+            .is_none()
+    );
+    assert_eq!(
+        errors.borrow().as_slice(),
+        &[(path, "source path cannot be represented as UTF-8".to_owned())]
+    );
+}
+
+#[cfg(unix)]
+mod unix_tests {
+    use super::*;
+
+    #[test]
+    fn fifo_inputs_are_rejected_before_opening() {
+        let (_dir, root) = fixture();
+        let fifo = root.join("sources");
+        let output = toolchain::command("mkfifo", &root, &rustc_hash::FxHashMap::default())
+            .arg(&fifo)
+            .output()
+            .unwrap();
+        assert!(output.status.success(), "{}", String::from_utf8_lossy(&output.stderr));
+        for entry in [
+            loader::Entry::Files(vec![fifo.clone()]),
+            loader::Entry::rs_files_recursively(fifo.clone()),
+        ] {
+            let messages = messages(vec![entry], true);
+            let errors = errors(&messages);
+            assert_eq!(errors.len(), 1);
+            assert_eq!(errors[0].0, AsRef::<Path>::as_ref(&fifo));
+        }
+        let (sender, _receiver) = unbounded();
+        let mut handle = NotifyHandle::spawn_with_load_errors(sender);
+        assert!(handle.load_sync(&fifo).is_none());
+    }
+
+    #[test]
+    fn cyclic_directory_links_are_reported() {
+        let (_dir, root) = fixture();
+        std::os::unix::fs::symlink(".", root.join("loop")).unwrap();
+        let messages = messages(vec![loader::Entry::rs_files_recursively(root)], true);
+        let errors = errors(&messages);
+        assert_eq!(errors.len(), 1);
+        assert!(errors[0].0.ends_with("loop"));
+    }
+
+    #[test]
+    fn excluded_cyclic_links_do_not_invalidate_loading() {
+        let (_dir, root) = fixture();
+        let excluded = root.join("loop");
+        std::os::unix::fs::symlink(".", &excluded).unwrap();
+        let mut entry = loader::Entry::rs_files_recursively(root);
+        let loader::Entry::Directories(dirs) = &mut entry else { panic!("expected directories") };
+        dirs.exclude.push(excluded);
+        let messages = messages(vec![entry], true);
+        assert!(errors(&messages).is_empty(), "{:?}", errors(&messages));
+    }
+}
