+//! Select backend crate inputs before constructing any analysis snapshots.
+
+use std::path::Path;
+
+use anyhow::{Result, ensure};
+use hir::{Crate, Semantics};
+use ide::RootDatabase;
+use ide_db::{
+    FxHashSet,
+    base_db::{all_crates, salsa::Durability, set_all_crates_with_durability},
+};
+use vfs::{AbsPathBuf, FileId, Vfs};
+
+pub(super) fn requested_context(
+    root: &AbsPathBuf,
+    path: Option<&Path>,
+    name: Option<&str>,
+    observed_output: bool,
+) -> Result<Option<(AbsPathBuf, String)>> {
+    match (path, name) {
+        (None, None) => Ok(None),
+        (Some(path), Some(name)) => {
+            ensure!(observed_output, "crate selection requires observed context output");
+            ensure!(!name.is_empty(), "crate name must not be empty");
+            let root_path: &Path = root.as_path().as_ref();
+            let path = AbsPathBuf::assert_utf8(root_path.join(path)).normalize();
+            ensure!(path.starts_with(root), "selected crate root is outside the repository");
+            Ok(Some((path, name.to_owned())))
+        }
+        _ => anyhow::bail!("crate selection requires both root and name"),
+    }
+}
+
+pub(super) fn select_crate(
+    db: &mut RootDatabase,
+    vfs: &Vfs,
+    root: &AbsPathBuf,
+    name: &str,
+) -> Result<Crate> {
+    let candidates = Crate::all(db)
+        .into_iter()
+        .filter(|krate| {
+            vfs.file_path(krate.root_file(db))
+                .as_path()
+                .is_some_and(|path| path.normalize() == *root)
+                && krate.display_name(db).is_some_and(|display| display.to_string() == name)
+        })
+        .collect::<Vec<_>>();
+    ensure!(candidates.len() == 1, "selected backend crate root/name is missing or ambiguous");
+    let selected = candidates[0];
+    let mut keep = FxHashSet::default();
+    let mut work = vec![selected];
+    while let Some(krate) = work.pop() {
+        if keep.insert(krate) {
+            work.extend(krate.dependencies(db).into_iter().map(|dependency| dependency.krate));
+        }
+    }
+    // Preserve upstream topological order and unmodified compiler dependency inputs.
+    let retained = all_crates(db)
+        .iter()
+        .copied()
+        .filter(|krate| keep.contains(&Crate::from(*krate)))
+        .collect::<Vec<_>>();
+    ensure!(retained.len() == keep.len(), "selected compiler dependency closure is incomplete");
+    set_all_crates_with_durability(db, retained, Durability::HIGH);
+    Ok(selected)
+}
+
+#[cfg(test)]
+fn document_owner(db: &RootDatabase, file: FileId) -> Result<Crate> {
+    let counts = super::sniff_source_context::association_counts(db);
+    document_owner_with_counts(db, file, &counts)
+}
+
+pub(super) fn document_owner_with_counts(
+    db: &RootDatabase,
+    file: FileId,
+    counts: &ide_db::FxHashMap<FileId, usize>,
+) -> Result<Crate> {
+    ensure!(
+        counts.get(&file) == Some(&1),
+        "indexed source has missing or competing compiler file/include/block associations: {file:?}"
+    );
+    hir::attach_db(db, || {
+        let sema = Semantics::new(db);
+        let modules = sema.file_to_module_defs(file).collect::<Vec<_>>();
+        ensure!(
+            modules.len() == 1,
+            "indexed source has missing or ambiguous compiler module ownership: {file:?}"
+        );
+        Ok(modules[0].krate(db))
+    })
+}
