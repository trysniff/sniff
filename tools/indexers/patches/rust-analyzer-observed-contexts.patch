+fn fixture(dependency: bool) -> (temp_dir::TempDir, AbsPathBuf, ManifestPath) {
+    let dir = temp_dir::TempDir::with_prefix("sniff-strict-metadata").unwrap();
+    let root = AbsPathBuf::assert_utf8(dir.path().to_path_buf());
+    std::fs::create_dir_all(root.join("src")).unwrap();
+    std::fs::write(root.join("src/lib.rs"), "pub fn probe() {}\n").unwrap();
+    let dependencies = if dependency {
+        "\n[dependencies]\nsniff_nonexistent_metadata_dependency_6fc5ba1c = \"=0.0.1\"\n"
+    } else {
+        ""
+    };
+    std::fs::write(root.join("Cargo.toml"), format!(
+        "[workspace]\n[package]\nname = \"sniff_metadata_probe\"\nversion = \"0.0.0\"\nedition = \"2024\"\n{dependencies}"
+    )).unwrap();
+    let manifest = ManifestPath::try_from(root.join("Cargo.toml")).unwrap();
+    (dir, root, manifest)
