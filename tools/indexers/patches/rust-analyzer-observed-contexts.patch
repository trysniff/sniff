+        assert!(result.unwrap_err().to_string().contains("finished"));
+        let (id, _) = vfs.file_id(&VfsPath::new_virtual_path("/valid.rs".to_owned())).unwrap();
+        assert_eq!(db.file_text(id).text(&db).as_ref(), "unchanged");
+    }
+
+    #[test]
+    fn ordinary_loader_keeps_existing_invalid_utf8_behavior() {
