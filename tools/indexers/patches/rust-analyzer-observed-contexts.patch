+#[test]
+fn strict_requires_original_lockfile_and_accepts_full_locked_graph() {
+    let (_dir, root, manifest) = fixture(false);
+    let strict = FetchMetadata::new(&manifest, &root, &config(true), &Sysroot::empty(), false);
+    let error = strict.exec(false, &|_| {}).unwrap_err();
+    assert!(format!("{error:#}").contains("lock file"));
+    assert!(std::fs::metadata(root.join("Cargo.lock")).is_err());
+    let mut legacy_config = config(false);
+    legacy_config.toolchain_version = None;
+    let legacy = FetchMetadata::new(&manifest, &root, &legacy_config, &Sysroot::empty(), false);
+    assert!(legacy.exec(false, &|_| {}).unwrap().1.is_none());
+    let lockfile = std::fs::read(root.join("Cargo.lock")).unwrap();
+    let strict = FetchMetadata::new(&manifest, &root, &config(true), &Sysroot::empty(), false);
+    let (full, error) = strict.exec(false, &|_| {}).unwrap();
+    assert!(error.is_none());
+    assert!(full.resolve.is_some());
+    assert_eq!(std::fs::read(root.join("Cargo.lock")).unwrap(), lockfile);
+}
