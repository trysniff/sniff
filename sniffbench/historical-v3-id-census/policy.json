{
  "schema_version": 1,
  "census_id": "historical-v3-post-aug7-public-id-census-v1",
  "source": "https://api.github.com/repositories",
  "metadata_source": "https://api.github.com/graphql",
  "api_version": "2022-11-28",
  "rest_request_rule": "GET /repositories?per_page=100&since=<cursor>;application/vnd.github+json;follow_verified_rel_next_since",
  "graphql_request_rule": "POST /graphql nodes(ids:[ID!]!) in REST page order;id databaseId nameWithOwner createdAt primaryLanguage.name isArchived isFork isTemplate mirrorUrl isPrivate",
  "auth_scope": "public_repository_metadata_only;reject_graphql_isPrivate_true",
  "created_at_or_after_utc": "2026-08-08T00:00:00Z",
  "created_before_utc": "2026-08-15T00:00:00Z",
  "repository_created_after_utc": "2026-08-07T20:46:11Z",
  "languages": ["Go", "JavaScript", "Kotlin", "Python", "Rust", "TypeScript"],
  "rest_page_size": 100,
  "graphql_batch_size": 100,
  "include_forks": false,
  "include_archived": false,
  "include_mirrors": false,
  "include_templates": false,
  "require_public_at_enrichment": true,
  "start_rule": "binary_search_first_public_repository_at_or_after_start_then_retain_preceding_boundary",
  "stop_rule": "retain_first_page_crossing_created_before_utc",
  "ordering": "github_repository_id_ascending_with_nondecreasing_created_at",
  "ordering_assumption": "github_public_repository_list_is_in_creation_order_as_documented;observed_inversion_fails_closed;live_visibility_changes_are_not_an_atomic_snapshot",
  "population": "public_at_rest_listing_and_public_at_graphql_enrichment_observation_not_historical_snapshot",
  "metadata_rule": "single_graphql_observation_per_rest_id;node_id_and_database_id_must_match;graphql_name_and_primary_language_authoritative",
  "name_rule": "canonical_lowercase_github.com_owner_repository_from_graphql_nameWithOwner",
  "eligibility_rule": "created_at_in_window_and_after_cutoff;exclude_forks_archived_mirrors_templates;exact_primary_language_match",
  "missing_metadata_rule": "fail_closed_without_frame",
  "pagination_error_rule": "fail_closed_without_frame",
  "source_failure_rule": "fail_closed_without_search_fallback",
  "transport_retry_rule": "retry_only_transport_timeout_429_or_5xx_with_same_request;retain_attempts;stop_after_12_failed_attempts",
  "prior_identity_rule": "strict_created_at_after_2026-08-07T20:46:11Z_is_prior_cohort_disjointness_proof;name_filter_is_conservative_only",
  "precommit_rule": "before_first_rest_probe_fetch_immutable_public_git_policy_url;verify_exact_bytes_and_sha256_against_pinned_public_hash_and_typed_contract;retain_preflight_receipt",
  "frame_ids": {
    "Go": "historical-v3-post-aug7-id-census-go",
    "JavaScript": "historical-v3-post-aug7-id-census-javascript",
    "Kotlin": "historical-v3-post-aug7-id-census-kotlin",
    "Python": "historical-v3-post-aug7-id-census-python",
    "Rust": "historical-v3-post-aug7-id-census-rust",
    "TypeScript": "historical-v3-post-aug7-id-census-typescript"
  },
  "attestation": "Must be committed publicly before collecting this census or inspecting candidate identities, labels, or Sniff output. The six frames share one live, non-atomic public-ID traversal. No Search-derived frame or partial checkpoint is substituted."
}
