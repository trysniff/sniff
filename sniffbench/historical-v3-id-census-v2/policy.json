  "missing_metadata_rule": "permit_a_null_only_if_exactly_one_error_has_type_NOT_FOUND,path_[nodes,zero_based_batch_index],and_message_Could_not_resolve_to_a_node_with_the_global_id_of_'<requested_node_id>'.;reject_error_on_nonnull_node_or_any_other_error;on_retained_crawl_page_count_as_creation_time_unknown_population_exclusion;probe_only_count_as_boundary_evidence_not_exclusion;all_other_nulls_errors_or_missing_metadata_fail_closed_without_frames",
  "null_audit_rule": "record_every_unique_observed_null_REST_ID_and_node_ID_with_GraphQL_exchange_sequence_and_batch_index_and_exact_error_path_and_message;mark_probe_only_as_boundary_evidence_or_crawled_as_population_exclusion;never_classify_its_creation_time_or_window_membership;replay_and_hash_bind_the_ledger",
  "pagination_error_rule": "REST_page_length_at_most_100;each_ID_unique_strictly_increasing_and_greater_than_request_since;reject_malformed_or_duplicate_IDs_without_sorting_or_deduplication;verify_next_since_equals_last_listed_ID_on_full_or_short_nonempty_page;missing_or_changed_next_before_upper_witness_fails_closed_without_frames",
  "artifact_rule": "before_first_live_v2_REST_request_publish_and_pin_typed_v2_manifest_and_null_ledger_schemas_with_exact_byte_serialization;replay_raw_exchanges_to_rederive_six_frames,probe_only_null_count,crawled_null_count_and_each_ledger_record;hash_bind_exact_ledger_bytes_and_all_frames;no_partial_manifest",
  "source_failure_rule": "fail_closed_without_search_or_REST_by_name_fallback",
  "transport_retry_rule": "retry_only_transport_timeout_429_or_5xx_with_same_request;retain_attempts;stop_after_12_failed_attempts",
  "prior_identity_rule": "prior_cohort_disjointness_is_a_separate_evidence_gate;this_census_alone_does_not_authorize_an_official_score",
  "precommit_rule": "before_first_REST_probe_fetch_immutable_public_git_policy_url;verify_exact_bytes_and_sha256_against_pinned_public_hash_and_typed_contract;retain_preflight_receipt;typed_v2_artifact_contract_must_also_be_publicly_SHA_pinned_before_any_live_v2_request",
  "frame_ids": {
    "Go": "historical-v3-post-aug7-id-census-v2-go",
