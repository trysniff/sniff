  "start_rule": "from_since_0_enrich_entire_returned_verified_REST_pages_until_first_resolved_repository;require_it_before_start;retain_its_page_cursor_as_lower;probe_since_2^k_for_k_0_through_63_skipping_values_not_above_lower_until_resolved_at_or_after_start;null_probe_moves_no_bound;empty_probe_fails;binary_mid_floor_lower_plus_half_gap_using_only_resolved_first_ID_witnesses;on_first_null_binary_probe_stop_narrowing_and_crawl_from_lower",
  "stop_rule": "follow_every_verified_next_cursor_and_enrich_every_id_until_a_retained_page_contains_a_resolved_created_at_on_or_after_2026-08-15T00:00:00Z;null_only_page_never_stops",
  "ordering": "github_repository_id_ascending_with_nondecreasing_created_at_among_resolved_repositories",
  "ordering_assumption": "github_public_repository_list_is_in_creation_order_including_unresolved_ids;observed_resolved_inversion_fails_closed;live_visibility_changes_are_not_an_atomic_snapshot",
  "population": "IDs_on_retained_verified_crawl_pages_with_matching_public_nonnull_GraphQL_Repository_in_one_committed_observation;probe_only_IDs_are_boundary_evidence_not_cohort_members;not_all_REST_listed_repositories_or_a_historical_snapshot",
  "metadata_rule": "single_GraphQL_observation_per_REST_ID_including_nulls;node_id_and_database_id_must_match_for_resolved_repositories;GraphQL_name_and_primary_language_authoritative",
  "name_rule": "canonical_lowercase_github.com_owner_repository_from_graphql_nameWithOwner",
